# Property-based tests for the ternary search tree — DECLARATIVE SPEC FORMAT.
#
# Same invariants as the other variants, plus a cross-check that a TstSet
# and a TrieSet built from identical keys agree exactly.
#
# Run:
#   aql test/tst_prop_spec.aql


import "aql:test"
import "./tst.aql"
import "./trie.aql"


def charset "abcdefghijklmnopqrstuvwxyz"


def starts-with fn [
  [pfx:String s:String] [Boolean] [
    def n (pfx size)
    if ((s size) lt n) [false] [ (s slice 0 n) pfx eq ]
  ]
]

def tst-of fn [
  [keys:List] [Any] [
    (TstSet.make) keys [ var [[k acc] acc k TstSet.add end ] ] fold
  ]
]

def trie-of fn [
  [keys:List] [Map] [
    (TrieSet.make) keys [ var [[k acc] acc k TrieSet.add end ] ] fold
  ]
]

def list-eq fn [
  [a:List b:List] [Boolean] [
    if (((a size) (b size) eq) not) [false] [
      true (iota (a size)) [ var [[i acc] acc ((a get (i)) (b get (i)) eq) and ] ] fold
    ]
  ]
]

def all-have-prefix fn [
  [p:String xs:List] [Boolean] [
    (xs each [ var [[x] x p starts-with ] ]) all end
  ]
]

def report fn [
  [res:Map] [] [
    def ok (res "ok" get)
    def nm (res "name" get)
    def msg (if ok
      [`ok   ${nm} (${(res "runs" get)} runs)`]
      [`FAIL ${nm}  failing-input: ${(res "failing-input" get)}`])
    msg print
  ]
]


def specs [

  (Test.prop "add-then-has"
    [ r.string charset (r.int 1 12) ]
    [ var [[key]
        def s ((TstSet.make) key TstSet.add)
        (s key TstSet.has)
    ] ])

  (Test.prop "empty-has-nothing"
    [ r.string charset (r.int 1 12) ]
    [ var [[key] ((TstSet.make) key TstSet.has) not ] ])

  (Test.prop "set-then-get"
    [ do { k: [r.string charset (r.int 1 12)], v: [r.int 0 1000] } ]
    [ var [[in]
        def k (in "k" get)
        def v (in "v" get)
        def t ((TstMap.make) k v TstMap.set)
        (t k TstMap.get) v eq
    ] ])

  (Test.prop "bulk-all-present"
    [ r.list-of [ r.string charset (r.int 1 8) ] (r.int 1 15) ]
    [ var [[keys]
        def s (keys tst-of)
        (keys each [ var [[k] s k TstSet.has end ] ]) all end
    ] ])

  (Test.prop "prefix-sound"
    [ r.list-of [ r.string charset (r.int 1 8) ] (r.int 1 15) ]
    [ var [[keys]
        def s (keys tst-of)
        def p (keys get 0)
        def hits (s p TstSet.with-prefix)
        hits p all-have-prefix
    ] ])

  (Test.prop "delete-removes-one"
    [ r.list-of [ r.string charset (r.int 1 8) ] (r.int 2 15) ]
    [ var [[keys]
        def s (keys tst-of)
        def k (keys get 0)
        def before (s TstSet.size)
        def s2 (s k TstSet.delete)
        def gone ((s2 k TstSet.has) not)
        def smaller ((s2 TstSet.size) (before 1 sub) eq)
        gone smaller and
    ] ])

  # CROSS-CHECK: a TstSet and a TrieSet over identical keys expose the same
  # sorted key list. The TST's in-order walk must agree with the trie.
  (Test.prop "tst-matches-trie"
    [ r.list-of [ r.string charset (r.int 1 8) ] (r.int 1 20) ]
    [ var [[keys]
        def a (keys tst-of)
        def b (keys trie-of)
        (a TstSet.keys) (b TrieSet.keys) list-eq
    ] ])

  (Test.prop "longest-prefix-nested"
    [ r.string charset 10 ]
    [ var [[s]
        def k1 (s slice 0 2)
        def k2 (s slice 0 5)
        def t (((TstSet.make) k1 TstSet.add) k2 TstSet.add)
        (t s TstSet.longest-prefix) k2 eq
    ] ])

]


def _ (specs each [ var [[s] (s Test.run-property end) report 0 ] ])


# --- summary -------------------------------------------------------

"---" print
"fail count: " print Test.fail-count end print
0 Test.fail-count end Assert.equal end
"all green" print
