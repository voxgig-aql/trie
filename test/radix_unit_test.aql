# Radix-tree tests using boru:test's imperative API.
#
# Runs identically under the interpreter, `aql check`, and the bytecode
# compiler:
#   aql test/radix_unit_test.aql
#   aql check test/radix_unit_test.aql
#   aql --force-compile test/radix_unit_test.aql


import "boru:test"
import "./radix.aql"


# Keys chosen to exercise edge splits and shared prefixes:
#   test, team share "te"; slow/slower/slowest nest; toast shares only "t".
# A shared immutable value (not a `fn`): tries never mutate, and a user-`fn`
# call inside a `Test.test` quotation is a bytecode-compiler refusal.
def fixture
  (((((( RadixMap.make)
    "test"    1 RadixMap.set)
    "team"    2 RadixMap.set)
    "toast"   3 RadixMap.set)
    "slow"    4 RadixMap.set)
    "slower"  5 RadixMap.set)


# --- empty -----------------------------------------------------------

[
  def t (RadixMap.make)
  0     (t RadixMap.size)           Assert.equal end
  false (t "x" RadixMap.has)        Assert.equal end
  none  (t "x" RadixMap.get)        Assert.equal end
  []    (t RadixMap.keys)           Assert.equal end
] "radix-empty" Test.test end


# --- set / get, including a key that is a prefix of another ---------

[
  def t (fixture)
  1 (t "test"   RadixMap.get) Assert.equal end
  2 (t "team"   RadixMap.get) Assert.equal end
  3 (t "toast"  RadixMap.get) Assert.equal end
  4 (t "slow"   RadixMap.get) Assert.equal end
  5 (t "slower" RadixMap.get) Assert.equal end
  # "te" is an internal split point, not a stored key
  false (t "te" RadixMap.has) Assert.equal end
  none  (t "te" RadixMap.get) Assert.equal end
  # "slow" is a real key AND a prefix of "slower"
  true  (t "slow" RadixMap.has) Assert.equal end
] "radix-set-get" Test.test end


# --- insert that forces an edge split keeps both keys ---------------

[
  def t0 ((RadixMap.make) "test" 1 RadixMap.set)
  # at this point the root has a single edge labelled "test"
  def t1 (t0 "team" 2 RadixMap.set)   # must split "test" at "te"
  1 (t1 "test" RadixMap.get) Assert.equal end
  2 (t1 "team" RadixMap.get) Assert.equal end
  ["team" "test"] (t1 RadixMap.keys) Assert.equal end
] "radix-split" Test.test end


# --- overwrite + persistence ----------------------------------------

[
  def t  (fixture)
  def t2 (t "team" 99 RadixMap.set)
  99 (t2 "team" RadixMap.get) Assert.equal end
  2  (t  "team" RadixMap.get) Assert.equal end
] "radix-overwrite" Test.test end


# --- stats + sorted keys --------------------------------------------

[
  def t (fixture)
  5 (t RadixMap.size) Assert.equal end
  ["slow" "slower" "team" "test" "toast"] (t RadixMap.keys) Assert.equal end
] "radix-stats" Test.test end


# --- prefix queries, including a prefix ending mid-edge -------------

[
  def t (fixture)
  ["team" "test"] (t "te" RadixMap.keys-with-prefix) Assert.equal end
  ["slow" "slower"] (t "slo" RadixMap.keys-with-prefix) Assert.equal end
  ["slow" "slower"] (t "slow" RadixMap.keys-with-prefix) Assert.equal end
  ["slower"] (t "slowe" RadixMap.keys-with-prefix) Assert.equal end
  [] (t "z" RadixMap.keys-with-prefix) Assert.equal end
] "radix-prefix" Test.test end


# --- longest-prefix --------------------------------------------------

[
  def t (fixture)
  "toast" (t "toaster" RadixMap.longest-prefix) Assert.equal end
  "slow"  (t "slowing" RadixMap.longest-prefix) Assert.equal end
  "slower"(t "slower"  RadixMap.longest-prefix) Assert.equal end
  none    (t "zoo"     RadixMap.longest-prefix) Assert.equal end
] "radix-longest-prefix" Test.test end


# --- delete with branch merge ---------------------------------------

[
  def t  (fixture)
  # removing "slower" leaves "slow" the only key on that branch; the
  # intermediate node must merge so "slow" and "slowest"-style siblings stay.
  def t2 (t "slower" RadixMap.delete)
  false (t2 "slower" RadixMap.has) Assert.equal end
  true  (t2 "slow"   RadixMap.has) Assert.equal end
  4     (t2 RadixMap.size) Assert.equal end
  # removing a non-leaf key ("slow") keeps its descendant ("slower")
  def t3 (t "slow" RadixMap.delete)
  false (t3 "slow"   RadixMap.has) Assert.equal end
  true  (t3 "slower" RadixMap.has) Assert.equal end
  # deleting an absent key is a no-op
  def t4 (t "nope" RadixMap.delete)
  5 (t4 RadixMap.size) Assert.equal end
] "radix-delete" Test.test end


# --- entries + values ------------------------------------------------

[
  def t (((RadixMap.make) "a" 10 RadixMap.set) "ab" 20 RadixMap.set)
  [["a" 10] ["ab" 20]] (t RadixMap.entries) Assert.equal end
  [10 20]              (t RadixMap.values) Assert.equal end
] "radix-entries" Test.test end


# --- RadixSet --------------------------------------------------------

[
  def s ((((RadixSet.make)
    "romane"  RadixSet.add)
    "romanus" RadixSet.add)
    "rubicon" RadixSet.add)
  true  (s "romane"  RadixSet.has) Assert.equal end
  false (s "roman"   RadixSet.has) Assert.equal end
  3     (s RadixSet.size) Assert.equal end
  ["romane" "romanus" "rubicon"] (s RadixSet.keys) Assert.equal end
  ["romane" "romanus"] (s "roman" RadixSet.with-prefix) Assert.equal end
  "romanus" (s "romanusXY" RadixSet.longest-prefix) Assert.equal end
  def s2 (s "romane" RadixSet.delete)
  false (s2 "romane"  RadixSet.has) Assert.equal end
  true  (s2 "romanus" RadixSet.has) Assert.equal end
] "radix-set" Test.test end


# --- construction from data (round-trips keys / entries) ------------

[
  def t ((((RadixSet.make) "b" RadixSet.add) "a" RadixSet.add) "ab" RadixSet.add)
  def t2 ((t RadixSet.keys) RadixSet.from-keys)
  (t RadixSet.keys) (t2 RadixSet.keys) Assert.equal end
  def m (((RadixMap.make) "x" 1 RadixMap.set) "y" "do" RadixMap.set)
  def m2 ((m RadixMap.entries) RadixMap.from-entries)
  (m RadixMap.entries) (m2 RadixMap.entries) Assert.equal end
  "do" (m2 "y" RadixMap.get) Assert.equal end
] "radixset-from-data" Test.test end


# --- encode/decode round-trip ----------------------------------------

[
  def m (fixture)
  def m2 ((m RadixMap.encode) RadixMap.decode)
  (m RadixMap.entries) (m2 RadixMap.entries) Assert.equal end
  3 (m2 "toast" RadixMap.get) Assert.equal end

  def s ((((RadixSet.make) "slow" RadixSet.add) "slower" RadixSet.add) "team" RadixSet.add)
  def s2 ((s RadixSet.encode) RadixSet.decode)
  (s RadixSet.keys) (s2 RadixSet.keys) Assert.equal end

  # an empty tree survives the round-trip
  def e2 (((RadixMap.make) RadixMap.encode) RadixMap.decode)
  0 (e2 RadixMap.size) Assert.equal end

  # decoding a payload of the wrong kind raises a catchable, named error
  def msg (do [ ((s RadixSet.encode) RadixMap.decode) drop "no-raise" ]
           error [ var [[e] convert String (e "message" get) ] ])
  "RadixMap.decode: expected kind 'radixmap', got 'radixset'" msg Assert.equal end
] "codec-roundtrip" Test.test end


# --- summary -------------------------------------------------------

"---" print
"fail count: " print Test.fail-count end print
0 Test.fail-count end Assert.equal end
"all green" print
