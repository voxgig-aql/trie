# Burst-trie tests using boru:test's imperative API.
#
# Runs identically under the interpreter, `aql check`, and the bytecode
# compiler:
#   aql test/burst_unit_test.aql
#   aql check test/burst_unit_test.aql
#   aql --force-compile test/burst_unit_test.aql


import "boru:test"
import "./burst.aql"


# A shared immutable value (not a `fn`): tries never mutate, and a user-`fn`
# call inside a `Test.test` quotation is a bytecode-compiler refusal.
def fixture
  ((((( BurstMap.make)
    "cat"  1 BurstMap.set)
    "car"  2 BurstMap.set)
    "card" 3 BurstMap.set)
    "dog"  4 BurstMap.set)

# 12 keys all sharing the "key" prefix — well over burst-limit (8) — so the
# root bucket must *burst* into a trie node. Built from an entry list (a
# value, not a `fold`-driven generator: `fold`/`each` bodies are not yet
# lowerable by the bytecode compiler — see DX-REPORT.md).
def bursted
  ([["key0" 0] ["key1" 1] ["key2" 2] ["key3" 3] ["key4" 4] ["key5" 5]
    ["key6" 6] ["key7" 7] ["key8" 8] ["key9" 9] ["key10" 10] ["key11" 11]]
   BurstMap.from-entries)


# --- empty -----------------------------------------------------------

[
  def t (BurstMap.make)
  0     (t BurstMap.size)          Assert.equal end
  false (t "x" BurstMap.has)       Assert.equal end
  none  (t "x" BurstMap.get)       Assert.equal end
  []    (t BurstMap.keys)          Assert.equal end
] "burst-empty" Test.test end


# --- set / get ------------------------------------------------------

[
  def t (fixture)
  1 (t "cat"  BurstMap.get) Assert.equal end
  2 (t "car"  BurstMap.get) Assert.equal end
  3 (t "card" BurstMap.get) Assert.equal end
  4 (t "dog"  BurstMap.get) Assert.equal end
  false (t "ca" BurstMap.has) Assert.equal end
  none  (t "ca" BurstMap.get) Assert.equal end
] "burst-set-get" Test.test end


# --- overwrite + persistence ----------------------------------------

[
  def t  (fixture)
  def t2 (t "cat" 99 BurstMap.set)
  99 (t2 "cat" BurstMap.get) Assert.equal end
  1  (t  "cat" BurstMap.get) Assert.equal end
] "burst-overwrite" Test.test end


# --- a bucket bursts but keeps every key ----------------------------

[
  # 12 keys >> burst-limit (8), so the root bucket must burst into a trie.
  12 (bursted BurstMap.size) Assert.equal end
  # representative keys remain retrievable, with their values, across the burst
  0  (bursted "key0"  BurstMap.get) Assert.equal end
  7  (bursted "key7"  BurstMap.get) Assert.equal end
  11 (bursted "key11" BurstMap.get) Assert.equal end
  # a never-inserted key is absent
  false (bursted "nope" BurstMap.has) Assert.equal end
] "burst-bursts" Test.test end


# --- sorted keys + size ---------------------------------------------

[
  def t (fixture)
  4 (t BurstMap.size) Assert.equal end
  ["car" "card" "cat" "dog"] (t BurstMap.keys) Assert.equal end
] "burst-stats" Test.test end


# --- prefix queries -------------------------------------------------

[
  def t (fixture)
  ["car" "card" "cat"] (t "ca" BurstMap.keys-with-prefix) Assert.equal end
  ["card"]             (t "card" BurstMap.keys-with-prefix) Assert.equal end
  []                   (t "z" BurstMap.keys-with-prefix) Assert.equal end
  ["car" "card" "cat" "dog"] (t "" BurstMap.keys-with-prefix) Assert.equal end
] "burst-prefix" Test.test end


# --- prefix queries survive a burst ---------------------------------

[
  # keys key0..key11; prefix "key1" matches key1, key10, key11 even after the
  # bucket has burst (results stay key-sorted)
  ["key1" "key10" "key11"] (bursted "key1" BurstMap.keys-with-prefix) Assert.equal end
] "burst-prefix-after-burst" Test.test end


# --- longest-prefix --------------------------------------------------

[
  def t (fixture)
  "card" (t "cardiff" BurstMap.longest-prefix) Assert.equal end
  "car"  (t "carrot"  BurstMap.longest-prefix) Assert.equal end
  "cat"  (t "cat"     BurstMap.longest-prefix) Assert.equal end
  none   (t "zebra"   BurstMap.longest-prefix) Assert.equal end
] "burst-longest-prefix" Test.test end


# --- delete ----------------------------------------------------------

[
  def t  (fixture)
  def t2 (t "car" BurstMap.delete)
  false (t2 "car"  BurstMap.has) Assert.equal end
  true  (t2 "card" BurstMap.has) Assert.equal end
  true  (t2 "cat"  BurstMap.has) Assert.equal end
  3     (t2 BurstMap.size) Assert.equal end
  def t3 (t2 "nope" BurstMap.delete)
  3     (t3 BurstMap.size) Assert.equal end
] "burst-delete" Test.test end


# --- entries + values + reserved-word values ------------------------

[
  def t (((BurstMap.make) "a" 10 BurstMap.set) "ab" "do" BurstMap.set)
  [["a" 10] ["ab" "do"]] (t BurstMap.entries) Assert.equal end
  [10 "do"]              (t BurstMap.values) Assert.equal end
  "do" (t "ab" BurstMap.get) Assert.equal end
] "burst-entries" Test.test end


# --- BurstSet --------------------------------------------------------

[
  def s ((((BurstSet.make)
    "alpha" BurstSet.add)
    "alpine" BurstSet.add)
    "beta" BurstSet.add)
  true  (s "alpha"  BurstSet.has) Assert.equal end
  false (s "alp"    BurstSet.has) Assert.equal end
  3     (s BurstSet.size) Assert.equal end
  ["alpha" "alpine" "beta"] (s BurstSet.keys) Assert.equal end
  ["alpha" "alpine"] (s "alp" BurstSet.with-prefix) Assert.equal end
  "alpha" (s "alphabet" BurstSet.longest-prefix) Assert.equal end
  def s2 (s "alpha" BurstSet.delete)
  false (s2 "alpha"  BurstSet.has) Assert.equal end
  true  (s2 "alpine" BurstSet.has) Assert.equal end
] "burst-set" Test.test end


# --- construction from data (round-trips keys / entries) ------------

[
  def t ((((BurstSet.make) "b" BurstSet.add) "a" BurstSet.add) "ab" BurstSet.add)
  def t2 ((t BurstSet.keys) BurstSet.from-keys)
  (t BurstSet.keys) (t2 BurstSet.keys) Assert.equal end
  def m (((BurstMap.make) "x" 1 BurstMap.set) "y" "do" BurstMap.set)
  def m2 ((m BurstMap.entries) BurstMap.from-entries)
  (m BurstMap.entries) (m2 BurstMap.entries) Assert.equal end
  "do" (m2 "y" BurstMap.get) Assert.equal end
] "burstset-from-data" Test.test end


# --- encode/decode round-trip ----------------------------------------

[
  def m (fixture)
  def m2 ((m BurstMap.encode) BurstMap.decode)
  (m BurstMap.entries) (m2 BurstMap.entries) Assert.equal end
  3 (m2 "card" BurstMap.get) Assert.equal end

  # a set big enough to burst its root bucket also round-trips
  def big (["a" "b" "c" "d" "e" "f" "g" "h" "i" "j"] BurstSet.from-keys)
  def big2 ((big BurstSet.encode) BurstSet.decode)
  (big BurstSet.keys) (big2 BurstSet.keys) Assert.equal end
  10 (big2 BurstSet.size) Assert.equal end

  # an empty tree survives the round-trip
  def e2 (((BurstMap.make) BurstMap.encode) BurstMap.decode)
  0 (e2 BurstMap.size) Assert.equal end

  # decoding a payload of the wrong kind raises a catchable, named error
  def msg (do [ ((big BurstSet.encode) BurstMap.decode) drop "no-raise" ]
           error [ var [[e] convert String (e "message" get) ] ])
  "BurstMap.decode: expected kind 'burstmap', got 'burstset'" msg Assert.equal end
] "codec-roundtrip" Test.test end


# --- summary -------------------------------------------------------

"---" print
"fail count: " print Test.fail-count end print
0 Test.fail-count end Assert.equal end
"all green" print
