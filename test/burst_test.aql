# Burst-trie tests using aql:test's imperative API.
#
# Run:
#   aql test/burst_test.aql


"aql:test"    import end
"aql:report"  import end
"./burst.aql" import end


def fixture fn [
  [] [Map] [
    ((((( BurstMap.make end)
      "cat"  1 BurstMap.set end)
      "car"  2 BurstMap.set end)
      "card" 3 BurstMap.set end)
      "dog"  4 BurstMap.set end)
  ]
]

# Insert keys key0..key(n-1) -> 0..n-1 to force buckets to burst.
def many fn [
  [n:Integer] [Map] [
    (BurstMap.make end) (iota n) [
      var [[i acc] def k ([ "key" (convert String i) ] concat) acc k i BurstMap.set end ]
    ] fold
  ]
]


# --- empty -----------------------------------------------------------

[
  def t (BurstMap.make end)
  0     (t BurstMap.size end)          assert.equal end
  false (t "x" BurstMap.has end)       assert.equal end
  none  (t "x" BurstMap.get end)       assert.equal end
  []    (t BurstMap.keys end)          assert.equal end
] "burst-empty" test.test end


# --- set / get ------------------------------------------------------

[
  def t (fixture)
  1 (t "cat"  BurstMap.get end) assert.equal end
  2 (t "car"  BurstMap.get end) assert.equal end
  3 (t "card" BurstMap.get end) assert.equal end
  4 (t "dog"  BurstMap.get end) assert.equal end
  false (t "ca" BurstMap.has end) assert.equal end
  none  (t "ca" BurstMap.get end) assert.equal end
] "burst-set-get" test.test end


# --- overwrite + persistence ----------------------------------------

[
  def t  (fixture)
  def t2 (t "cat" 99 BurstMap.set end)
  99 (t2 "cat" BurstMap.get end) assert.equal end
  1  (t  "cat" BurstMap.get end) assert.equal end
] "burst-overwrite" test.test end


# --- a bucket bursts but keeps every key ----------------------------

[
  # 30 keys >> burst-limit (8), so the root bucket must burst into a trie.
  def t (30 many)
  30 (t BurstMap.size end) assert.equal end
  # every inserted key is still retrievable with its value
  def hits (iota 30 each [
    var [[i]
      def k ([ "key" (convert String i) ] concat)
      if ((t k BurstMap.get end) i eq) [1] [0]
    ]
  ])
  30 (0 hits [add end] fold) assert.equal end
  # a never-inserted key is absent
  false (t "nope" BurstMap.has end) assert.equal end
] "burst-bursts" test.test end


# --- sorted keys + size ---------------------------------------------

[
  def t (fixture)
  4 (t BurstMap.size end) assert.equal end
  ["car" "card" "cat" "dog"] (t BurstMap.keys end) assert.equal end
] "burst-stats" test.test end


# --- prefix queries -------------------------------------------------

[
  def t (fixture)
  ["car" "card" "cat"] (t "ca" BurstMap.keys-with-prefix end) assert.equal end
  ["card"]             (t "card" BurstMap.keys-with-prefix end) assert.equal end
  []                   (t "z" BurstMap.keys-with-prefix end) assert.equal end
  ["car" "card" "cat" "dog"] (t "" BurstMap.keys-with-prefix end) assert.equal end
] "burst-prefix" test.test end


# --- prefix queries survive a burst ---------------------------------

[
  def t (30 many)
  # keys key0..key29; prefix "key1" matches key1, key10..key19
  def hits (t "key1" BurstMap.keys-with-prefix end)
  11 (hits size) assert.equal end
] "burst-prefix-after-burst" test.test end


# --- longest-prefix --------------------------------------------------

[
  def t (fixture)
  "card" (t "cardiff" BurstMap.longest-prefix end) assert.equal end
  "car"  (t "carrot"  BurstMap.longest-prefix end) assert.equal end
  "cat"  (t "cat"     BurstMap.longest-prefix end) assert.equal end
  none   (t "zebra"   BurstMap.longest-prefix end) assert.equal end
] "burst-longest-prefix" test.test end


# --- delete ----------------------------------------------------------

[
  def t  (fixture)
  def t2 (t "car" BurstMap.delete end)
  false (t2 "car"  BurstMap.has end) assert.equal end
  true  (t2 "card" BurstMap.has end) assert.equal end
  true  (t2 "cat"  BurstMap.has end) assert.equal end
  3     (t2 BurstMap.size end) assert.equal end
  def t3 (t2 "nope" BurstMap.delete end)
  3     (t3 BurstMap.size end) assert.equal end
] "burst-delete" test.test end


# --- entries + values + reserved-word values ------------------------

[
  def t (((BurstMap.make end) "a" 10 BurstMap.set end) "ab" "do" BurstMap.set end)
  [["a" 10] ["ab" "do"]] (t BurstMap.entries end) assert.equal end
  [10 "do"]              (t BurstMap.values  end) assert.equal end
  "do" (t "ab" BurstMap.get end) assert.equal end
] "burst-entries" test.test end


# --- BurstSet --------------------------------------------------------

[
  def s ((((BurstSet.make end)
    "alpha" BurstSet.add end)
    "alpine" BurstSet.add end)
    "beta" BurstSet.add end)
  true  (s "alpha"  BurstSet.has end) assert.equal end
  false (s "alp"    BurstSet.has end) assert.equal end
  3     (s BurstSet.size end) assert.equal end
  ["alpha" "alpine" "beta"] (s BurstSet.keys end) assert.equal end
  ["alpha" "alpine"] (s "alp" BurstSet.with-prefix end) assert.equal end
  "alpha" (s "alphabet" BurstSet.longest-prefix end) assert.equal end
  def s2 (s "alpha" BurstSet.delete end)
  false (s2 "alpha"  BurstSet.has end) assert.equal end
  true  (s2 "alpine" BurstSet.has end) assert.equal end
] "burst-set" test.test end


# --- summary -------------------------------------------------------

"---" print
"fail count: " print test.fail-count end print
0 test.fail-count end assert.equal end
"all green" print
