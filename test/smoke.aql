# Smoke demo for the trie utilities. Imports all four variants and walks
# the common surface of each, so `aql test/smoke.aql` is a quick end-to-end
# check that every module loads and answers.

"./trie.aql"  import end
"./radix.aql" import end
"./tst.aql"   import end
"./burst.aql" import end

"--- trie utilities smoke demo ---" print


# --- TrieMap: the standard prefix tree, used as a map ---------------

def words ["cat" "car" "card" "cart" "dog"]

def tm ((TrieMap.make end) words [ var [[w acc] acc w (w size) TrieMap.set end ] ] fold)

"" print
"TrieMap keys:        " print (tm TrieMap.keys end) print
"TrieMap get 'card':  " print (tm "card" TrieMap.get end) print
"TrieMap prefix 'car':" print (tm "car" TrieMap.keys-with-prefix end) print
"TrieMap longest of 'cartoon':" print (tm "cartoon" TrieMap.longest-prefix end) print
"TrieMap size/height: " print `${(tm TrieMap.size end)} / ${(tm TrieMap.height end)}` print


# --- RadixSet: the compressed variant, used as a set ----------------

def rs (((((RadixSet.make end)
  "romane"  RadixSet.add end)
  "romanus" RadixSet.add end)
  "romulus" RadixSet.add end)
  "rubens"  RadixSet.add end)

"" print
"RadixSet keys:       " print (rs RadixSet.keys end) print
"RadixSet has 'roman':" print (rs "roman" RadixSet.has end) print
"RadixSet prefix 'rom':" print (rs "rom" RadixSet.with-prefix end) print


# --- TstSet: ternary search tree ------------------------------------

def ts ((((TstSet.make end)
  "in"  TstSet.add end)
  "inn" TstSet.add end)
  "tin" TstSet.add end)

"" print
"TstSet keys:         " print (ts TstSet.keys end) print
"TstSet longest 'innings':" print (ts "innings" TstSet.longest-prefix end) print


# --- BurstMap: burst trie, exercised past its burst limit -----------

def bm ((BurstMap.make end) (iota 20) [
  var [[i acc]
    def k ([ "item-" (convert String i) ] concat)
    acc k i BurstMap.set end
  ]
] fold)

"" print
"BurstMap size:       " print (bm BurstMap.size end) print
"BurstMap get 'item-7':" print (bm "item-7" BurstMap.get end) print
"BurstMap prefix 'item-1':" print (bm "item-1" BurstMap.keys-with-prefix end) print
"BurstMap encode:     " print (bm BurstMap.encode end) print
