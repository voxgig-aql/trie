# Smoke demo for the trie utilities. Imports all four variants and walks
# the common surface of each, so `aql test/smoke.aql` is a quick end-to-end
# check that every module loads and answers.

import "./trie.aql"
import "./radix.aql"
import "./tst.aql"
import "./burst.aql"

"--- trie utilities smoke demo ---" print


# --- TrieMap: the standard prefix tree, used as a map ---------------

def words ["cat" "car" "card" "cart" "dog"]

def tm ((TrieMap.make) words [ var [[w acc] acc w (w size) TrieMap.set end ] ] fold)

"" print
"TrieMap keys:        " print (tm TrieMap.keys) print
"TrieMap get 'card':  " print (tm "card" TrieMap.get) print
"TrieMap prefix 'car':" print (tm "car" TrieMap.keys-with-prefix) print
"TrieMap longest of 'cartoon':" print (tm "cartoon" TrieMap.longest-prefix) print
"TrieMap size/height: " print `${(tm TrieMap.size)} / ${(tm TrieMap.height)}` print


# --- RadixSet: the compressed variant, used as a set ----------------

def rs (((((RadixSet.make)
  "romane"  RadixSet.add)
  "romanus" RadixSet.add)
  "romulus" RadixSet.add)
  "rubens"  RadixSet.add)

"" print
"RadixSet keys:       " print (rs RadixSet.keys) print
"RadixSet has 'roman':" print (rs "roman" RadixSet.has) print
"RadixSet prefix 'rom':" print (rs "rom" RadixSet.with-prefix) print


# --- TstSet: ternary search tree ------------------------------------

def ts ((((TstSet.make)
  "in"  TstSet.add)
  "inn" TstSet.add)
  "tin" TstSet.add)

"" print
"TstSet keys:         " print (ts TstSet.keys) print
"TstSet longest 'innings':" print (ts "innings" TstSet.longest-prefix) print


# --- BurstMap: burst trie, exercised past its burst limit -----------

def bm ((BurstMap.make) (iota 20) [
  var [[i acc]
    def k ([ "item-" (convert String i) ] concat)
    acc k i BurstMap.set end
  ]
] fold)

"" print
"BurstMap size:       " print (bm BurstMap.size) print
"BurstMap get 'item-7':" print (bm "item-7" BurstMap.get) print
"BurstMap prefix 'item-1':" print (bm "item-1" BurstMap.keys-with-prefix) print
"BurstMap encode:     " print (bm BurstMap.encode) print
