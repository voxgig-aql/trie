# Standard-trie tests using aql:test's imperative API.
#
# Run:
#   aql test/trie_test.aql


import "aql:test"
import "aql:report"
import "./trie.aql"


# Build a small fixture map: cat=1 car=2 card=3 dog=4.
def fixture fn [
  [] [Map] [
    ((((( TrieMap.make)
      "cat"  1 TrieMap.set)
      "car"  2 TrieMap.set)
      "card" 3 TrieMap.set)
      "dog"  4 TrieMap.set)
  ]
]


# --- TrieMap: empty trie ---------------------------------------------

[
  def t (TrieMap.make)
  0     (t TrieMap.size)            assert.equal end
  false (t "anything" TrieMap.has)  assert.equal end
  none  (t "anything" TrieMap.get)  assert.equal end
  []    (t TrieMap.keys)            assert.equal end
] "map-empty" test.test end


# --- TrieMap: set then get/has --------------------------------------

[
  def t (fixture)
  1     (t "cat"  TrieMap.get) assert.equal end
  2     (t "car"  TrieMap.get) assert.equal end
  3     (t "card" TrieMap.get) assert.equal end
  4     (t "dog"  TrieMap.get) assert.equal end
  true  (t "cat"  TrieMap.has) assert.equal end
  # a pure prefix is not itself a key
  false (t "ca"   TrieMap.has) assert.equal end
  none  (t "ca"   TrieMap.get) assert.equal end
] "map-set-get" test.test end


# --- TrieMap: set overwrites the value ------------------------------

[
  def t  (fixture)
  def t2 (t "cat" 99 TrieMap.set)
  99 (t2 "cat" TrieMap.get) assert.equal end
  # other keys untouched
  2  (t2 "car" TrieMap.get) assert.equal end
  # original is unchanged (persistence)
  1  (t "cat"  TrieMap.get) assert.equal end
] "map-overwrite" test.test end


# --- TrieMap: size, height, keys, values, entries -------------------

[
  def t (fixture)
  4 (t TrieMap.size) assert.equal end
  4 (t TrieMap.height) assert.equal end
  ["car" "card" "cat" "dog"] (t TrieMap.keys) assert.equal end
] "map-stats" test.test end


# --- TrieMap: prefix queries ----------------------------------------

[
  def t (fixture)
  ["car" "card" "cat"] (t "ca" TrieMap.keys-with-prefix) assert.equal end
  ["card"]             (t "card" TrieMap.keys-with-prefix) assert.equal end
  # a prefix that is present in no key yields nothing
  []                   (t "z" TrieMap.keys-with-prefix) assert.equal end
  # whole-trie prefix
  ["car" "card" "cat" "dog"] (t "" TrieMap.keys-with-prefix) assert.equal end
] "map-prefix" test.test end


# --- TrieMap: longest-prefix ----------------------------------------

[
  def t (fixture)
  "card" (t "cardiff"  TrieMap.longest-prefix) assert.equal end
  "car"  (t "carrot"   TrieMap.longest-prefix) assert.equal end
  "cat"  (t "cat"      TrieMap.longest-prefix) assert.equal end
  none   (t "zebra"    TrieMap.longest-prefix) assert.equal end
] "map-longest-prefix" test.test end


# --- TrieMap: delete prunes only the target -------------------------

[
  def t  (fixture)
  def t2 (t "car" TrieMap.delete)
  false (t2 "car"  TrieMap.has) assert.equal end
  # "card" sits below "car" and must survive
  true  (t2 "card" TrieMap.has) assert.equal end
  true  (t2 "cat"  TrieMap.has) assert.equal end
  3     (t2 TrieMap.size) assert.equal end
  # deleting an absent key is a no-op
  def t3 (t2 "nope" TrieMap.delete)
  3     (t3 TrieMap.size) assert.equal end
] "map-delete" test.test end


# --- TrieMap: entries and values are key-sorted ---------------------

[
  def t (((TrieMap.make) "b" 2 TrieMap.set) "a" 1 TrieMap.set)
  [["a" 1] ["b" 2]] (t TrieMap.entries) assert.equal end
  [1 2]             (t TrieMap.values) assert.equal end
] "map-entries" test.test end


# --- TrieSet: add / has / membership --------------------------------

[
  def s ((((TrieSet.make)
    "app"    TrieSet.add)
    "apple"  TrieSet.add)
    "banana" TrieSet.add)
  true  (s "app"    TrieSet.has) assert.equal end
  true  (s "apple"  TrieSet.has) assert.equal end
  false (s "appl"   TrieSet.has) assert.equal end
  false (s "orange" TrieSet.has) assert.equal end
  3     (s TrieSet.size) assert.equal end
  ["app" "apple" "banana"] (s TrieSet.keys) assert.equal end
] "set-add-has" test.test end


# --- TrieSet: prefix + longest --------------------------------------

[
  def s (((TrieSet.make)
    "app"   TrieSet.add)
    "apple" TrieSet.add)
  ["app" "apple"] (s "app" TrieSet.with-prefix) assert.equal end
  "apple" (s "applesauce" TrieSet.longest-prefix) assert.equal end
  "app"   (s "appliance"  TrieSet.longest-prefix) assert.equal end
] "set-prefix" test.test end


# --- TrieSet: delete -------------------------------------------------

[
  def s ((((TrieSet.make)
    "app"   TrieSet.add)
    "apple" TrieSet.add)
    "apply" TrieSet.add)
  def s2 (s "app" TrieSet.delete)
  false (s2 "app"   TrieSet.has) assert.equal end
  true  (s2 "apple" TrieSet.has) assert.equal end
  true  (s2 "apply" TrieSet.has) assert.equal end
] "set-delete" test.test end


# --- fuzzy (edit distance) search -----------------------------------

[
  def t ((((((( TrieSet.make)
    "cat" TrieSet.add) "car" TrieSet.add) "card" TrieSet.add)
    "cab" TrieSet.add) "dog" TrieSet.add) "cart" TrieSet.add)
  # within 1 of "cat": cat(0), car(1), cab(1), cart(1) — NOT card(2), NOT dog
  ["cab" "car" "cart" "cat"] (t "cat" 1 TrieSet.within) assert.equal end
  # within 0 is exact match only
  ["car"] (t "car" 0 TrieSet.within) assert.equal end
  # nothing close to a far query
  [] (t "zzzz" 1 TrieSet.within) assert.equal end
  # the empty key counts: distance from "" to a 1-char query is 1
  def s ((TrieSet.make) "" TrieSet.add)
  [""] (s "x" 1 TrieSet.within) assert.equal end
] "set-within" test.test end


# --- wildcard match -------------------------------------------------

[
  def t ((((( TrieSet.make)
    "cat" TrieSet.add) "car" TrieSet.add) "card" TrieSet.add)
    "dog" TrieSet.add)
  ["car" "cat"]        (t "ca?" TrieSet.match) assert.equal end
  ["car" "card" "cat"] (t "ca*" TrieSet.match) assert.equal end
  ["card"]             (t "c?rd" TrieSet.match) assert.equal end
  ["car" "card" "cat" "dog"] (t "*" TrieSet.match) assert.equal end
  ["card"]             (t "*d" TrieSet.match) assert.equal end
] "set-match" test.test end


# --- construction from data (round-trips keys / entries) ------------

[
  def t ((((TrieSet.make) "b" TrieSet.add) "a" TrieSet.add) "ab" TrieSet.add)
  def t2 ((t TrieSet.keys) TrieSet.from-keys)
  (t TrieSet.keys) (t2 TrieSet.keys) assert.equal end
  3 (t2 TrieSet.size) assert.equal end

  def m (((TrieMap.make) "x" 1 TrieMap.set) "y" 2 TrieMap.set)
  def m2 ((m TrieMap.entries) TrieMap.from-entries)
  (m TrieMap.entries) (m2 TrieMap.entries) assert.equal end
  1 (m2 "x" TrieMap.get) assert.equal end
] "from-data" test.test end


# --- summary -------------------------------------------------------

"---" print
"fail count: " print test.fail-count end print
0 test.fail-count end assert.equal end
"all green" print
