# Ternary-search-tree tests using aql:test's imperative API.
#
# Run:
#   aql test/tst_test.aql


import "aql:test"
import "aql:report"
import "./tst.aql"


def fixture fn [
  [] [Any] [
    ((((( TstMap.make)
      "cat"  1 TstMap.set)
      "car"  2 TstMap.set)
      "card" 3 TstMap.set)
      "dog"  4 TstMap.set)
  ]
]


# --- empty (an empty TST is `none`) ---------------------------------

[
  def t (TstMap.make)
  none  t                               assert.equal end
  0     (t TstMap.size)             assert.equal end
  false (t "anything" TstMap.has)   assert.equal end
  none  (t "anything" TstMap.get)   assert.equal end
  []    (t TstMap.keys)             assert.equal end
] "tst-empty" test.test end


# --- set / get ------------------------------------------------------

[
  def t (fixture)
  1 (t "cat"  TstMap.get) assert.equal end
  2 (t "car"  TstMap.get) assert.equal end
  3 (t "card" TstMap.get) assert.equal end
  4 (t "dog"  TstMap.get) assert.equal end
  false (t "ca" TstMap.has) assert.equal end
  none  (t "ca" TstMap.get) assert.equal end
] "tst-set-get" test.test end


# --- overwrite + persistence ----------------------------------------

[
  def t  (fixture)
  def t2 (t "cat" 99 TstMap.set)
  99 (t2 "cat" TstMap.get) assert.equal end
  1  (t  "cat" TstMap.get) assert.equal end
] "tst-overwrite" test.test end


# --- sorted keys + size ---------------------------------------------

[
  def t (fixture)
  4 (t TstMap.size) assert.equal end
  ["car" "card" "cat" "dog"] (t TstMap.keys) assert.equal end
] "tst-stats" test.test end


# --- prefix queries -------------------------------------------------

[
  def t (fixture)
  ["car" "card" "cat"] (t "ca" TstMap.keys-with-prefix) assert.equal end
  ["card"]             (t "card" TstMap.keys-with-prefix) assert.equal end
  []                   (t "z" TstMap.keys-with-prefix) assert.equal end
  ["car" "card" "cat" "dog"] (t "" TstMap.keys-with-prefix) assert.equal end
] "tst-prefix" test.test end


# --- longest-prefix --------------------------------------------------

[
  def t (fixture)
  "card" (t "cardiff" TstMap.longest-prefix) assert.equal end
  "car"  (t "carrot"  TstMap.longest-prefix) assert.equal end
  "cat"  (t "cat"     TstMap.longest-prefix) assert.equal end
  none   (t "zebra"   TstMap.longest-prefix) assert.equal end
] "tst-longest-prefix" test.test end


# --- delete ----------------------------------------------------------

[
  def t  (fixture)
  def t2 (t "car" TstMap.delete)
  false (t2 "car"  TstMap.has) assert.equal end
  true  (t2 "card" TstMap.has) assert.equal end
  true  (t2 "cat"  TstMap.has) assert.equal end
  3     (t2 TstMap.size) assert.equal end
  # deleting an absent key is a no-op
  def t3 (t2 "nope" TstMap.delete)
  3     (t3 TstMap.size) assert.equal end
  # delete every key ends back at an empty tree
  def e0 (fixture)
  def e1 (e0 "cat"  TstMap.delete)
  def e2 (e1 "car"  TstMap.delete)
  def e3 (e2 "card" TstMap.delete)
  def e4 (e3 "dog"  TstMap.delete)
  0 (e4 TstMap.size) assert.equal end
] "tst-delete" test.test end


# --- entries + values + reserved-word values ------------------------

[
  def t (((TstMap.make) "a" 10 TstMap.set) "ab" "do" TstMap.set)
  [["a" 10] ["ab" "do"]] (t TstMap.entries) assert.equal end
  [10 "do"]              (t TstMap.values) assert.equal end
  "do" (t "ab" TstMap.get) assert.equal end
] "tst-entries" test.test end


# --- TstSet ----------------------------------------------------------

[
  def s ((((TstSet.make)
    "in"   TstSet.add)
    "inn"  TstSet.add)
    "tin"  TstSet.add)
  true  (s "in"  TstSet.has) assert.equal end
  true  (s "inn" TstSet.has) assert.equal end
  false (s "i"   TstSet.has) assert.equal end
  3     (s TstSet.size) assert.equal end
  ["in" "inn" "tin"] (s TstSet.keys) assert.equal end
  ["in" "inn"] (s "in" TstSet.with-prefix) assert.equal end
  "inn" (s "innings" TstSet.longest-prefix) assert.equal end
  def s2 (s "in" TstSet.delete)
  false (s2 "in"  TstSet.has) assert.equal end
  true  (s2 "inn" TstSet.has) assert.equal end
] "tst-set" test.test end


# --- construction from data (round-trips keys / entries) ------------

[
  def t ((((TstSet.make) "b" TstSet.add) "a" TstSet.add) "ab" TstSet.add)
  def t2 ((t TstSet.keys) TstSet.from-keys)
  (t TstSet.keys) (t2 TstSet.keys) assert.equal end
  def m (((TstMap.make) "x" 1 TstMap.set) "y" "do" TstMap.set)
  def m2 ((m TstMap.entries) TstMap.from-entries)
  (m TstMap.entries) (m2 TstMap.entries) assert.equal end
  "do" (m2 "y" TstMap.get) assert.equal end
] "tstset-from-data" test.test end


# --- summary -------------------------------------------------------

"---" print
"fail count: " print test.fail-count end print
0 test.fail-count end assert.equal end
"all green" print
