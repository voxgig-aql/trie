# Property-based tests for the standard trie — DECLARATIVE SPEC FORMAT.
#
# This file exercises aql:test's declarative property surface: `Test.prop`
# builds a PropertySpec as data, and `Test.run-property` runs it at the
# default 100 iterations. The sibling file `test/trie_prop_test.aql` covers the
# same ideas through the imperative `Test.check-prop` driver.
#
# GEN-BODY runs with `r` (a seeded aql:rand instance) in scope and must leave
# exactly one value on the stack. PROPERTY-BODY takes that value and must
# return a Boolean.
#
# Run:
#   aql test/trie_prop_spec.aql


import "aql:test"
import "./trie.aql"


# Lowercase keys keep generated input readable; lengths stay short so the
# trees built per iteration are cheap.
def charset "abcdefghijklmnopqrstuvwxyz"


# True when string `s` begins with `pfx` (AQL has no prefix word).
# Call: `s pfx starts-with`.
def starts-with fn [
  [pfx:String s:String] [Boolean] [
    def n (pfx size)
    if ((s size) lt n) [false] [ (s slice 0 n) pfx eq ]
  ]
]

# Build a TrieSet from a list of keys.
def set-of fn [
  [ks:List] [Map] [
    (TrieSet.make) ks [
      var [[k acc] acc k TrieSet.add end ]
    ] fold
  ]
]

# Does every element of `xs` start with prefix `p`? Call: `xs p all-have-prefix`.
def all-have-prefix fn [
  [p:String xs:List] [Boolean] [
    (xs each [ var [[x] x p starts-with ] ]) all end
  ]
]

# Are all members of `xs` present in set `s`? Call: `xs s all-members`.
def all-members fn [
  [s:Map xs:List] [Boolean] [
    (xs each [ var [[x] s x TrieSet.has end ] ]) all end
  ]
]


def report fn [
  [res:Map] [] [
    def ok (res "ok" get)
    def nm (res "name" get)
    def msg (if ok
      [`ok   ${nm} (${(res "runs" get)} runs)`]
      [`FAIL ${nm}  failing-input: ${(res "failing-input" get)}`])
    msg print
  ]
]


def specs [

  # 1. add then has: a key just added is always a member.
  (Test.prop "add-then-has"
    [ r.string charset (r.int 1 12) ]
    [ var [[key]
        def s ((TrieSet.make) key TrieSet.add)
        (s key TrieSet.has)
    ] ])

  # 2. empty set contains nothing.
  (Test.prop "empty-has-nothing"
    [ r.string charset (r.int 1 12) ]
    [ var [[key] ((TrieSet.make) key TrieSet.has) not ] ])

  # 3. set then get returns exactly the value stored.
  (Test.prop "set-then-get"
    [ do { k: [r.string charset (r.int 1 12)], v: [r.int 0 1000] } ]
    [ var [[in]
        def k (in "k" get)
        def v (in "v" get)
        def t ((TrieMap.make) k v TrieMap.set)
        (t k TrieMap.get) v eq
    ] ])

  # 4. every inserted key is present afterwards (bulk no-false-negatives).
  (Test.prop "bulk-all-present"
    [ r.list-of [ r.string charset (r.int 1 8) ] (r.int 1 15) ]
    [ var [[ks]
        def s (ks set-of)
        (ks each [ var [[k] s k TrieSet.has end ] ]) all end
    ] ])

  # 5. size never exceeds the number of inserted keys (it equals the
  #    distinct count; duplicates collapse).
  (Test.prop "size-bounded-by-inserts"
    [ r.list-of [ r.string charset (r.int 1 8) ] (r.int 1 15) ]
    [ var [[ks]
        def s (ks set-of)
        (s TrieSet.size) (ks size) lte
    ] ])

  # 6. prefix soundness: everything keys-with-prefix returns really does
  #    start with that prefix.
  (Test.prop "prefix-sound"
    [ r.list-of [ r.string charset (r.int 1 8) ] (r.int 1 15) ]
    [ var [[ks]
        def s (ks set-of)
        def p (ks get 0)
        def hits (s p TrieSet.with-prefix)
        hits p all-have-prefix
    ] ])

  # 7. after deleting a key it is gone, and the set shrinks by exactly one.
  (Test.prop "delete-removes-one"
    [ r.list-of [ r.string charset (r.int 1 8) ] (r.int 2 15) ]
    [ var [[ks]
        def s (ks set-of)
        def k (ks get 0)
        def before (s TrieSet.size)
        def s2 (s k TrieSet.delete)
        def gone ((s2 k TrieSet.has) not)
        def smaller ((s2 TrieSet.size) (before 1 sub) eq)
        gone smaller and
    ] ])

  # 8. fuzzy soundness: every key returned by `within` is a real member.
  #    The query is an actual key, so the result is never empty.
  (Test.prop "within-subset"
    [ r.list-of [ r.string charset (r.int 1 6) ] (r.int 1 12) ]
    [ var [[ks]
        def s (ks set-of)
        def hits (s (ks get 0) 2 TrieSet.within)
        hits s all-members
    ] ])

  # 9. within 0 of a stored key is exactly that key.
  (Test.prop "within-zero-is-exact"
    [ r.list-of [ r.string charset (r.int 1 6) ] (r.int 1 12) ]
    [ var [[ks]
        def s (ks set-of)
        def q (ks get 0)
        def z (s q 0 TrieSet.within)
        z ([] q push) deq
    ] ])

  # 10. wildcard soundness: every key matching a pattern is a real member.
  (Test.prop "match-subset"
    [ r.list-of [ r.string charset (r.int 1 6) ] (r.int 1 12) ]
    [ var [[ks]
        def s (ks set-of)
        def pat ( (ks get 0) "*"  add)
        def hits (s pat TrieSet.match)
        hits s all-members
    ] ])

  # 11. from-keys round-trips: rebuilding from extracted keys is identical.
  (Test.prop "from-keys-roundtrip"
    [ r.list-of [ r.string charset (r.int 1 6) ] (r.int 1 12) ]
    [ var [[ks]
        def viaadd  ((ks set-of) TrieSet.keys)
        def viafrom ((ks TrieSet.from-keys) TrieSet.keys)
        viaadd viafrom deq
    ] ])

]


def _ (specs each [
  var [[s] (s Test.run-property end) report 0 ]
])


# --- summary -------------------------------------------------------

"---" print
"fail count: " print Test.fail-count end print
0 Test.fail-count end Assert.equal end
"all green" print
