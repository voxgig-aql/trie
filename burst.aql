# burst: a burst trie (the structure behind the HAT-trie) over String keys.
#
# This file exports TWO namespaces from one module:
#
#   BurstMap — an associative map keyed by String, with prefix queries.
#   BurstSet — a set of Strings (membership), over the same engine.
#
# A burst trie keeps keys in small *buckets* until a bucket grows past a
# threshold, at which point it *bursts* into a trie node whose children are
# fresh sub-buckets keyed by the next character. The shallow trie spine
# stays small while most keys live in flat, cache-friendly buckets — the
# idea a HAT-trie exploits for speed. (A true bitmap/array-mapped trie wants
# fixed-width bit vectors, which AQL's data model does not provide; the
# burst trie is the variant that maps naturally onto it.)
#
# --- representation -------------------------------------------------
#
# A node is one of two tagged Maps (bindings that hold one are named `nd`,
# because `node` itself is a reserved built-in word):
#
#   bucket: { kind: "bucket", items: [[suffix, value], …] }
#   trie:   { kind: "trie", end: Boolean, val: Any, kids: Map }
#
# A bucket holds the *remaining* suffixes of keys routed to it, paired with
# their values. Buckets stay flat, UNSORTED association lists — scan-and-
# rebuild is the whole point of the variant — and collectors sort a bucket's
# few items only at emission time. The spine's children are a computed-key
# Map (character → node): `kids get (ch)` looks up, copy-returning
# `kids set (ch) child` updates, and `StructUtil.items` enumerates in
# character order, so traversals emit keys already sorted.
#
# A trie node routes by one character and may itself end a key. The empty
# tree is an empty bucket, so a tree is always a Map.
#
# Trees are PERSISTENT: mutators return a new tree. Paths are assembled with
# core `add` (string concatenation). Membership is structural (`b-member`), so
# a stored `none` value stays distinct from an absent key.
#
# Calling convention: like the rest of AQL, the receiver comes first and the
# arguments follow — `t key val BurstMap.set`. Forward args have precedence, so
# a call resolves at the next word or paren; `end`/parens are needed only to
# separate a call from a following bare literal.
#
# Imported via `import "./burst.aql"`. The only dependency is the standard
# `aql:struct-util` module (map enumeration + jsonic parsing).

import "aql:struct-util"


# --- constants ------------------------------------------------------


# Maximum bucket size before it bursts. Small enough to keep buckets flat;
# the exact value only trades bucket scans against trie depth.
def burst-limit fn [ [] [Integer] [8] ]


# --- node construction ----------------------------------------------

def mk-bucket fn [ [items:Any] [Map] [ do {kind: ["bucket"], items: [items]} ] ]

# `fin` is the terminal flag (named `fin`, not the reserved `end`). Call: `kids val fin mk-trienode`.
def mk-trienode fn [
  [fin:Any val:Any kids:Any] [Map] [
    do {kind: ["trie"], end: [fin], val: [val], kids: [kids]}
  ]
]

def is-bucket fn [ [nd:Map] [Boolean] [ (nd "kind" get) "bucket" eq ] ]

# A node holding nothing: an empty bucket, or a trie node with no key and no
# children. Such nodes are pruned after a delete.
def is-empty fn [
  [nd:Map] [Boolean] [
    if (nd is-bucket) [ ((nd "items" get) size) eq 0 ] [
      ((nd "end" get) not) and (((nd "kids" get) size) eq 0)
    ]
  ]
]


# --- bucket + child helpers -----------------------------------------

# The value stored under `key` in a bucket's items, or `none`.
# Call: `items key bucket-find`.
def bucket-find fn [
  [key:String items:List] [Any] [
    none items [ var [[pair acc] if ((pair get 0) key eq) [pair get 1] [acc] ] ] fold
  ]
]

# Items with `key` set to `val` (replacing any existing entry).
# Call: `items key val bucket-set`.
def bucket-set fn [
  [val:Any key:String items:List] [List] [
    def kept (items filter [ var [[pair] ((pair get 0) key eq) not ] ])
    kept [key val] push
  ]
]

# Items with `key` removed. Call: `items key bucket-del`.
def bucket-del fn [
  [key:String items:List] [List] [
    items filter [ var [[pair] ((pair get 0) key eq) not ] ]
  ]
]

# A bucket's items sorted by suffix (suffixes are distinct, so the pair's
# first column decides). Collectors emit through this so their output stays
# lexicographic without a global sort. Call: `nd sorted-items`.
def sorted-items fn [
  [nd:Map] [List] [ (nd "items" get) sort ]
]

# The spine children of `nd` as character-sorted [char, node] pairs.
# Call: `nd kid-items`.
def kid-items fn [
  [nd:Map] [List] [ (nd "kids" get) StructUtil.items ]
]

# The child node under char `ch`, or `none`. Call: `nd ch find-kid`.
def find-kid fn [
  [ch:String nd:Map] [Any] [ (nd "kids" get) get (ch) ]
]

# `nd` with the child under `ch` replaced by `child`. Call: `nd ch child put-kid`.
def put-kid fn [
  [child:Map ch:String nd:Map] [Map] [
    ((nd "kids" get) set (ch) child) (nd "val" get) (nd "end" get) mk-trienode
  ]
]

# `nd` with the child under `ch` removed. There is no key-removal word for
# maps, so rebuild the children from their entries, skipping `ch`.
# Call: `nd ch drop-kid`.
def drop-kid fn [
  [ch:String nd:Map] [Map] [
    def kept ({} ((nd "kids" get) StructUtil.items) [
      var [[pair acc]
        if ((pair get 0) ch eq) [acc] [acc set ((pair get 0)) (pair get 1)]
      ]
    ] fold)
    kept (nd "val" get) (nd "end" get) mk-trienode
  ]
]


# --- core: insert + burst -------------------------------------------

# Insert `key` → `val` into `nd`. A bucket that overflows
# bursts into a trie node. Call: `nd key val b-insert`.
def b-insert fn [
  [val:Any key:String nd:Map] [Map] [
    if (nd is-bucket) [
      def items2 ((nd "items" get) key val bucket-set)
      if ((items2 size) gt (burst-limit)) [ items2 b-burst ] [ items2 mk-bucket ]
    ] [
      if ((key size) eq 0) [ (nd "kids" get) val true mk-trienode ] [
        def ch (key slice 0 1)
        def rest (key slice 1 (key size))
        def child (nd ch find-kid)
        def child2 (if (child eq none)
          [ ([] mk-bucket) rest val b-insert ]
          [ child rest val b-insert ])
        nd ch child2 put-kid
      ]
    ]
  ]
]

# Burst a bucket's items into a trie node by re-inserting each into an empty
# trie node (which routes them into fresh sub-buckets). Call: `items b-burst`.
def b-burst fn [
  [items:List] [Map] [
    def start ({} none false mk-trienode)
    start items [ var [[pair acc] (acc (pair get 0) (pair get 1) b-insert) ] ] fold
  ]
]


# --- core: locate ---------------------------------------------------

# The value bound to `key`, or `none` if absent. Call: `nd key b-getval`.
# (`none` is ambiguous between absent and a stored `none` value — use
# `b-member` for membership, which keys off structure, not the value.)
def b-getval fn [
  [key:String nd:Map] [Any] [
    if (nd is-bucket) [ (nd "items" get) key bucket-find ] [
      if ((key size) eq 0) [ if (nd "end" get) [nd "val" get] [none] ] [
        def ch (key slice 0 1)
        def rest (key slice 1 (key size))
        def child (nd ch find-kid)
        if (child eq none) [none] [ child rest b-getval ]
      ]
    ]
  ]
]

# Whether a bucket's items contain `key`. Call: `items key bucket-has`.
def bucket-has fn [
  [key:String items:List] [Boolean] [
    false items [ var [[pair acc] if ((pair get 0) key eq) [true] [acc] ] ] fold
  ]
]

# Structural membership for `key` (independent of the stored value, so it is
# correct even when the value is `none`). Call: `nd key b-member`.
def b-member fn [
  [key:String nd:Map] [Boolean] [
    if (nd is-bucket) [ (nd "items" get) key bucket-has ] [
      if ((key size) eq 0) [ nd "end" get ] [
        def ch (key slice 0 1)
        def rest (key slice 1 (key size))
        def child (nd ch find-kid)
        if (child eq none) [false] [ child rest b-member ]
      ]
    ]
  ]
]


# --- traversal ------------------------------------------------------
#
# Spine children enumerate in character order (`kid-items`) and buckets emit
# their few items suffix-sorted (`sorted-items`), so the collectors below
# produce keys already in lexicographic order.

# True when `s` begins with `pfx`. Call: `s pfx starts-with`.
def starts-with fn [
  [pfx:String s:String] [Boolean] [
    def n (pfx size)
    if ((s size) lt n) [false] [ (s slice 0 n) pfx eq ]
  ]
]

# Append every key at or below `nd` (prefixed by `prefix`) to `acc`,
# in sorted order. Call: `acc prefix nd collect-b`.
def collect-b fn [
  [nd:Map prefix:String acc:List] [List] [
    if (nd is-bucket) [
      acc (nd sorted-items) [
        var [[pair a] def np (prefix (pair get 0) add) a np push ]
      ] fold
    ] [
      def acc1 (if (nd "end" get) [acc prefix push] [acc])
      acc1 (nd kid-items) [
        var [[pair a] def np (prefix (pair get 0) add) (a np (pair get 1) collect-b) ]
      ] fold
    ]
  ]
]

# As `collect-b`, but appends [key, value] pairs. Call: `acc prefix nd collect-eb`.
def collect-eb fn [
  [nd:Map prefix:String acc:List] [List] [
    if (nd is-bucket) [
      acc (nd sorted-items) [
        var [[pair a]
          def np (prefix (pair get 0) add)
          def v (pair get 1)
          a ([] np push v push) push
        ]
      ] fold
    ] [
      def acc1 (if (nd "end" get) [acc [prefix (nd "val" get)] push] [acc])
      acc1 (nd kid-items) [
        var [[pair a] def np (prefix (pair get 0) add) (a np (pair get 1) collect-eb) ]
      ] fold
    ]
  ]
]

# Keys at or below `prefix`, sorted. `consumed` is the path already walked.
# Call: `acc consumed prefix nd navigate-prefix`.
def navigate-prefix fn [
  [nd:Map prefix:String consumed:String acc:List] [List] [
    if ((prefix size) eq 0) [ acc consumed nd collect-b ] [
      if (nd is-bucket) [
        acc (nd sorted-items) [
          var [[pair a]
            def suf (pair get 0)
            if (suf prefix starts-with) [ def np (consumed suf add) a np push ] [a]
          ]
        ] fold
      ] [
        def ch (prefix slice 0 1)
        def rest (prefix slice 1 (prefix size))
        def child (nd ch find-kid)
        if (child eq none) [acc] [
          def nc (consumed ch add)
          (acc nc rest child navigate-prefix)
        ]
      ]
    ]
  ]
]

# Longest stored key that is a prefix of `key`. `consumed` is the path so
# far; `best` the best terminating prefix seen. Call: `best consumed key nd longest-b`.
def longest-b fn [
  [nd:Map key:String consumed:String best:Any] [Any] [
    if (nd is-bucket) [
      best (nd "items" get) [
        var [[pair acc]
          def suf (pair get 0)
          if (key suf starts-with) [
            def cand (consumed suf add)
            def acclen (if (acc eq none) [-1] [acc size])
            if ((cand size) gt acclen) [cand] [acc]
          ] [acc]
        ]
      ] fold
    ] [
      def best2 (if (nd "end" get) [consumed] [best])
      if ((key size) eq 0) [best2] [
        def ch (key slice 0 1)
        def rest (key slice 1 (key size))
        def child (nd ch find-kid)
        if (child eq none) [best2] [
          def nc (consumed ch add)
          if (nd "end" get) [ (consumed nc rest child longest-b) ] [ (best nc rest child longest-b) ]
        ]
      ]
    ]
  ]
]

# Number of keys at or below `nd`. Call: `nd count-b`.
def count-b fn [
  [nd:Map] [Integer] [
    if (nd is-bucket) [ (nd "items" get) size ] [
      def here (if (nd "end" get) [1] [0])
      here (nd kid-items) [ var [[pair acc] acc ((pair get 1) count-b) add ] ] fold
    ]
  ]
]

# Structural depth in nodes (a bucket counts as 1). Call: `nd height-b`.
def height-b fn [
  [nd:Map] [Integer] [
    if (nd is-bucket) [1] [
      def kmax (0 (nd kid-items) [
        var [[pair acc] def h ((pair get 1) height-b) if (h gt acc) [h] [acc] ]
      ] fold)
      kmax 1 add
    ]
  ]
]


# --- core: delete ---------------------------------------------------

# Remove `key` from `nd`, pruning emptied buckets and nodes.
# Call: `nd key b-delete`.
def b-delete fn [
  [key:String nd:Map] [Map] [
    if (nd is-bucket) [ ((nd "items" get) key bucket-del) mk-bucket ] [
      if ((key size) eq 0) [ (nd "kids" get) none false mk-trienode ] [
        def ch (key slice 0 1)
        def rest (key slice 1 (key size))
        def child (nd ch find-kid)
        if (child eq none) [nd] [
          def child2 (child rest b-delete)
          if (child2 is-empty) [ nd ch drop-kid ] [ nd ch child2 put-kid ]
        ]
      ]
    ]
  ]
]


# --- BurstMap surface -----------------------------------------------

def map-make fn [ [] [Map] [ [] mk-bucket ] ]

def map-set fn [ [val:Any key:String t:Map] [Map] [ t key val b-insert ] ]

def map-get fn [ [key:String t:Map] [Any] [ t key b-getval ] ]

def map-has fn [ [key:String t:Map] [Boolean] [ t key b-member ] ]

def map-delete fn [ [key:String t:Map] [Map] [ t key b-delete ] ]

def map-keys fn [ [t:Map] [List] [ [] "" t collect-b ] ]

def map-entries fn [ [t:Map] [List] [ [] "" t collect-eb ] ]

# Values in key order: entries is already sorted [key, value] pairs, so
# pluck the value column with the `$.1` lens — no per-key lookup.
def map-values fn [
  [t:Map] [List] [ (t map-entries) each $.1 ]
]

def map-size fn [ [t:Map] [Integer] [ t count-b ] ]

def map-height fn [ [t:Map] [Integer] [ t height-b ] ]

def map-keys-with-prefix fn [
  [prefix:String t:Map] [List] [ [] "" prefix t navigate-prefix ]
]

def map-entries-with-prefix fn [
  [prefix:String t:Map] [List] [
    def ks ([] "" prefix t navigate-prefix)
    ks each [ var [[k] def v (t k map-get) [] k push v push ] ]
  ]
]

def map-longest-prefix fn [ [key:String t:Map] [Any] [ none "" key t longest-b ] ]

# Rebuild a map from a list of [key, value] pairs (inverse of `entries`).
def map-from-entries fn [
  [entries:List] [Map] [
    ([] mk-bucket) entries [ var [[e acc] (acc (e get 0) (e get 1) b-insert) ] ] fold
  ]
]

def map-encode fn [
  [t:Map] [String] [
    def es ([] "" t collect-eb)
    def payload (do {kind: ["burstmap"], size: [t count-b], entries: [es]})
    payload StructUtil.jsonify
  ]
]

# Rebuild a map from an `encode` string (raises on a non-burstmap payload).
def map-decode fn [
  [s:String] [Map] [
    def p (s StructUtil.parse)
    if ((p "kind" get) "burstmap" eq) [ (p "entries" get) map-from-entries ] [
      def msg `BurstMap.decode: expected kind 'burstmap', got '${(p "kind" get)}'`
      raise msg
    ]
  ]
]


# --- BurstSet surface -----------------------------------------------

def set-make fn [ [] [Map] [ [] mk-bucket ] ]

def set-add fn [ [key:String t:Map] [Map] [ t key true b-insert ] ]

def set-has fn [ [key:String t:Map] [Boolean] [ t key b-member ] ]

def set-delete fn [ [key:String t:Map] [Map] [ t key b-delete ] ]

def set-keys fn [ [t:Map] [List] [ [] "" t collect-b ] ]

def set-size fn [ [t:Map] [Integer] [ t count-b ] ]

def set-height fn [ [t:Map] [Integer] [ t height-b ] ]

def set-with-prefix fn [
  [prefix:String t:Map] [List] [ [] "" prefix t navigate-prefix ]
]

def set-longest-prefix fn [ [key:String t:Map] [Any] [ none "" key t longest-b ] ]

# Rebuild a set from a list of keys (inverse of `keys`).
def set-from-keys fn [
  [ks:List] [Map] [
    ([] mk-bucket) ks [ var [[k acc] (acc k true b-insert) ] ] fold
  ]
]

def set-encode fn [
  [t:Map] [String] [
    def ks ([] "" t collect-b)
    def payload (do {kind: ["burstset"], size: [t count-b], keys: [ks]})
    payload StructUtil.jsonify
  ]
]

# Rebuild a set from an `encode` string (raises on a non-burstset payload).
def set-decode fn [
  [s:String] [Map] [
    def p (s StructUtil.parse)
    if ((p "kind" get) "burstset" eq) [ (p "keys" get) set-from-keys ] [
      def msg `BurstSet.decode: expected kind 'burstset', got '${(p "kind" get)}'`
      raise msg
    ]
  ]
]


# --- namespaces -----------------------------------------------------

export "BurstMap" {
  make:                map-make/r
  set:                 map-set/r
  get:                 map-get/r
  has:                 map-has/r
  delete:              map-delete/r
  keys:                map-keys/r
  values:              map-values/r
  entries:             map-entries/r
  size:                map-size/r
  height:              map-height/r
  keys-with-prefix:    map-keys-with-prefix/r
  entries-with-prefix: map-entries-with-prefix/r
  longest-prefix:      map-longest-prefix/r
  from-entries:        map-from-entries/r
  encode:              map-encode/r
  decode:              map-decode/r
}

export "BurstSet" {
  make:           set-make/r
  add:            set-add/r
  has:            set-has/r
  delete:         set-delete/r
  keys:           set-keys/r
  size:           set-size/r
  height:         set-height/r
  with-prefix:    set-with-prefix/r
  longest-prefix: set-longest-prefix/r
  from-keys:      set-from-keys/r
  encode:         set-encode/r
  decode:         set-decode/r
}
