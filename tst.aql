# tst: a ternary search tree over String keys, in AQL.
#
# This file exports TWO namespaces from one module:
#
#   TstMap — an associative map keyed by String, with prefix queries.
#   TstSet — a set of Strings (membership), over the same engine.
#
# A ternary search tree (TST) is a hybrid of a binary search tree and a
# trie. Each node holds a single character and three children:
#
#   lo  — subtree for characters that sort *before*  this node's character
#   mid — subtree for the *next* character, taken when this one matches
#   hi  — subtree for characters that sort *after*   this node's character
#
# Following `mid` advances through the key; `lo`/`hi` are an ordinary BST
# over the alternatives at one position. This needs far fewer pointers per
# node than a trie's full child map, handles large or sparse alphabets
# gracefully, and yields keys in sorted order under an in-order walk — at
# the cost of being a little deeper to descend.
#
# --- representation -------------------------------------------------
#
# A node is a Map { ch, end, val, lo, mid, hi }; an empty tree is `none`.
# Bindings that hold a node are named `nd` (`node` itself is a reserved
# built-in word), and the middle child is named "mid" (not "eq") because
# `eq` is a builtin word and would shadow the binding.
#
# TSTs here are PERSISTENT: every mutator returns a new tree, rebuilding the
# nodes along the edited path. Paths are assembled with core `add`.
#
# Imported via `import "./tst.aql"`. The only dependency is the standard
# `aql:struct-util` module (jsonic parsing for `decode`).

import "aql:struct-util"


# --- node construction ----------------------------------------------

# Build a node. `fin` is the terminal flag (named `fin`, not `end`, which is
# reserved). Call: `ch fin val lo mid hi mk-tnode`.
def mk-tnode fn [
  [hi:Any mid:Any lo:Any val:Any fin:Any ch:String] [Map] [
    do {ch: [ch], end: [fin], val: [val], lo: [lo], mid: [mid], hi: [hi]}
  ]
]

# Field-preserving rebuilds: each returns `nd` with one field replaced.
def with-lo  fn [ [lo:Any nd:Map] [Map] [ (nd "ch" get) (nd "end" get) (nd "val" get) lo (nd "mid" get) (nd "hi" get) mk-tnode ] ]
def with-mid fn [ [mid:Any nd:Map] [Map] [ (nd "ch" get) (nd "end" get) (nd "val" get) (nd "lo" get) mid (nd "hi" get) mk-tnode ] ]
def with-hi  fn [ [hi:Any nd:Map] [Map] [ (nd "ch" get) (nd "end" get) (nd "val" get) (nd "lo" get) (nd "mid" get) hi mk-tnode ] ]

# Replace the terminal flag and value. Call: `nd val fin with-end-val`.
def with-end-val fn [
  [fin:Any val:Any nd:Map] [Map] [
    (nd "ch" get) fin val (nd "lo" get) (nd "mid" get) (nd "hi" get) mk-tnode
  ]
]


# --- core: insert ---------------------------------------------------

# Insert/replace `key` → `val` into `nd` (an Any: a Map or `none`).
# Call: `nd key val tst-insert`.
def tst-insert fn [
  [val:Any key:String nd:Any] [Any] [
    def c (key slice 0 1)
    def nd (if (nd eq none) [ c false none none none none mk-tnode ] [nd])
    def ndc (nd "ch" get)
    if (c ndc lt) [
      def lo2 ((nd "lo" get) key val tst-insert) (nd lo2 with-lo)
    ] [
      if (c ndc gt) [
        def hi2 ((nd "hi" get) key val tst-insert) (nd hi2 with-hi)
      ] [
        def rest (key slice 1 (key size))
        if ((rest size) eq 0) [ (nd val true with-end-val) ] [
          def mid2 ((nd "mid" get) rest val tst-insert) (nd mid2 with-mid)
        ]
      ]
    ]
  ]
]


# --- core: locate ---------------------------------------------------

# The value bound to `key`, or `none`. Call: `nd key tst-get`.
def tst-get fn [
  [key:String nd:Any] [Any] [
    if (nd eq none) [none] [
      def c (key slice 0 1)
      def ndc (nd "ch" get)
      if (c ndc lt) [ (nd "lo" get) key tst-get ] [
        if (c ndc gt) [ (nd "hi" get) key tst-get ] [
          def rest (key slice 1 (key size))
          if ((rest size) eq 0)
            [ if (nd "end" get) [nd "val" get] [none] ]
            [ (nd "mid" get) rest tst-get ]
        ]
      ]
    ]
  ]
]

# The node matching the last character of `key`, or `none`. Used to locate
# the root of a prefix subtree. Call: `nd key find-node`.
def find-node fn [
  [key:String nd:Any] [Any] [
    if (nd eq none) [none] [
      def c (key slice 0 1)
      def ndc (nd "ch" get)
      if (c ndc lt) [ (nd "lo" get) key find-node ] [
        if (c ndc gt) [ (nd "hi" get) key find-node ] [
          def rest (key slice 1 (key size))
          if ((rest size) eq 0) [nd] [ (nd "mid" get) rest find-node ]
        ]
      ]
    ]
  ]
]


# --- traversal (in-order ⇒ sorted) ----------------------------------
#
# An in-order walk (lo, self, mid, hi) visits keys in lexicographic order —
# the TST property — so the collectors below emit sorted output and the
# listing words need no trailing sort.

# Append every terminating key at or below `nd` (prefixed by `prefix`) to
# `acc`, in sorted order. Call: `acc prefix nd collect-t`.
def collect-t fn [
  [nd:Any prefix:String acc:List] [List] [
    if (nd eq none) [acc] [
      def a1 (acc prefix (nd "lo" get) collect-t)
      def pc (prefix (nd "ch" get) add)
      def a2 (if (nd "end" get) [a1 pc push] [a1])
      def a3 (a2 pc (nd "mid" get) collect-t)
      a3 prefix (nd "hi" get) collect-t
    ]
  ]
]

# As `collect-t`, but appends [key, value] pairs. Call: `acc prefix nd collect-et`.
def collect-et fn [
  [nd:Any prefix:String acc:List] [List] [
    if (nd eq none) [acc] [
      def a1 (acc prefix (nd "lo" get) collect-et)
      def pc (prefix (nd "ch" get) add)
      def v (nd "val" get)
      def a2 (if (nd "end" get) [a1 [pc v] push] [a1])
      def a3 (a2 pc (nd "mid" get) collect-et)
      a3 prefix (nd "hi" get) collect-et
    ]
  ]
]

# Longest stored key that is a prefix of `key`. `consumed` is the path so
# far; `best` the best terminating prefix seen. Call: `best consumed key nd longest-t`.
def longest-t fn [
  [nd:Any key:String consumed:String best:Any] [Any] [
    if (nd eq none) [best] [
      def c (key slice 0 1)
      def ndc (nd "ch" get)
      if (c ndc lt) [ best consumed key (nd "lo" get) longest-t ] [
        if (c ndc gt) [ best consumed key (nd "hi" get) longest-t ] [
          def pc (consumed c add)
          def best2 (if (nd "end" get) [pc] [best])
          def rest (key slice 1 (key size))
          if ((rest size) eq 0) [best2] [ best2 pc rest (nd "mid" get) longest-t ]
        ]
      ]
    ]
  ]
]

# Number of keys at or below `nd`. Call: `nd count-t`.
def count-t fn [
  [nd:Any] [Integer] [
    if (nd eq none) [0] [
      def here (if (nd "end" get) [1] [0])
      def l ((nd "lo" get) count-t)
      def m ((nd "mid" get) count-t)
      def h ((nd "hi" get) count-t)
      here l add m add h add
    ]
  ]
]

# Structural depth of the ternary tree (counting all of lo/mid/hi).
# Call: `nd tst-height`.
def tst-height fn [
  [nd:Any] [Integer] [
    if (nd eq none) [0] [
      def l ((nd "lo" get) tst-height)
      def m ((nd "mid" get) tst-height)
      def h ((nd "hi" get) tst-height)
      def mx1 (if (l gt m) [l] [m])
      def mx  (if (mx1 gt h) [mx1] [h])
      mx 1 add
    ]
  ]
]


# --- core: delete ---------------------------------------------------

# Drop a node that has become completely empty (no key, no children).
def tprune fn [
  [nd:Any] [Any] [
    if (nd eq none) [none] [
      def empty (((nd "end" get) not)
        and (((nd "lo" get) eq none)
          and (((nd "mid" get) eq none) and ((nd "hi" get) eq none))))
      if empty [none] [nd]
    ]
  ]
]

# Remove `key` from `nd`, pruning fully-empty nodes. Call: `nd key tst-delete`.
def tst-delete fn [
  [key:String nd:Any] [Any] [
    if (nd eq none) [none] [
      def c (key slice 0 1)
      def ndc (nd "ch" get)
      if (c ndc lt) [
        def lo2 ((nd "lo" get) key tst-delete) (nd lo2 with-lo) tprune
      ] [
        if (c ndc gt) [
          def hi2 ((nd "hi" get) key tst-delete) (nd hi2 with-hi) tprune
        ] [
          def rest (key slice 1 (key size))
          if ((rest size) eq 0) [ (nd [] false with-end-val) tprune ] [
            def mid2 ((nd "mid" get) rest tst-delete) (nd mid2 with-mid) tprune
          ]
        ]
      ]
    ]
  ]
]


# --- TstMap surface -------------------------------------------------
#
# The tree parameter is typed `Any` because an empty tree is `none`, not a
# Map. Calls read receiver-first: `t key val TstMap.set end`.

def map-make fn [ [] [Any] [none] ]

def map-set fn [ [val:Any key:String t:Any] [Any] [ t key val tst-insert ] ]

def map-get fn [ [key:String t:Any] [Any] [ t key tst-get ] ]

def map-has fn [
  [key:String t:Any] [Boolean] [
    def n (t key find-node)
    if (n eq none) [false] [n "end" get]
  ]
]

def map-delete fn [ [key:String t:Any] [Any] [ t key tst-delete ] ]

def map-keys fn [ [t:Any] [List] [ [] "" t collect-t ] ]

def map-entries fn [ [t:Any] [List] [ [] "" t collect-et ] ]

# Values in key order: entries is already sorted [key, value] pairs, so
# pluck the value column with the `$.1` lens — no per-key lookup.
def map-values fn [
  [t:Any] [List] [ (t map-entries) each $.1 ]
]

def map-size fn [ [t:Any] [Integer] [ t count-t ] ]

def map-height fn [ [t:Any] [Integer] [ t tst-height ] ]

def map-keys-with-prefix fn [
  [prefix:String t:Any] [List] [
    if ((prefix size) eq 0) [ [] "" t collect-t ] [
      def pn (t prefix find-node)
      if (pn eq none) [[]] [
        def acc0 (if (pn "end" get) [[] prefix push] [[]])
        acc0 prefix (pn "mid" get) collect-t
      ]
    ]
  ]
]

def map-entries-with-prefix fn [
  [prefix:String t:Any] [List] [
    def ks (t prefix map-keys-with-prefix)
    ks each [ var [[k] def v (t k tst-get) [] k push v push ] ]
  ]
]

def map-longest-prefix fn [ [key:String t:Any] [Any] [ none "" key t longest-t ] ]

# Rebuild a map from a list of [key, value] pairs (inverse of `entries`).
def map-from-entries fn [
  [entries:List] [Any] [
    none entries [ var [[e acc] (acc (e get 0) (e get 1) tst-insert) ] ] fold
  ]
]

def map-encode fn [
  [t:Any] [String] [
    def es ([] "" t collect-et)
    def payload (do {kind: ["tstmap"], size: [t count-t], entries: [es]})
    payload StructUtil.jsonify
  ]
]

# Rebuild a map from an `encode` string (raises on a non-tstmap payload).
def map-decode fn [
  [s:String] [Any] [
    def p (s StructUtil.parse)
    if ((p "kind" get) "tstmap" eq) [ (p "entries" get) map-from-entries ] [
      def msg `TstMap.decode: expected kind 'tstmap', got '${(p "kind" get)}'`
      raise msg
    ]
  ]
]


# --- TstSet surface -------------------------------------------------

def set-make fn [ [] [Any] [none] ]

def set-add fn [ [key:String t:Any] [Any] [ t key true tst-insert ] ]

def set-has fn [
  [key:String t:Any] [Boolean] [
    def n (t key find-node)
    if (n eq none) [false] [n "end" get]
  ]
]

def set-delete fn [ [key:String t:Any] [Any] [ t key tst-delete ] ]

def set-keys fn [ [t:Any] [List] [ [] "" t collect-t ] ]

def set-size fn [ [t:Any] [Integer] [ t count-t ] ]

def set-height fn [ [t:Any] [Integer] [ t tst-height ] ]

def set-with-prefix fn [
  [prefix:String t:Any] [List] [
    if ((prefix size) eq 0) [ [] "" t collect-t ] [
      def pn (t prefix find-node)
      if (pn eq none) [[]] [
        def acc0 (if (pn "end" get) [[] prefix push] [[]])
        acc0 prefix (pn "mid" get) collect-t
      ]
    ]
  ]
]

def set-longest-prefix fn [ [key:String t:Any] [Any] [ none "" key t longest-t ] ]

# Rebuild a set from a list of keys (inverse of `keys`).
def set-from-keys fn [
  [ks:List] [Any] [
    none ks [ var [[k acc] (acc k true tst-insert) ] ] fold
  ]
]

def set-encode fn [
  [t:Any] [String] [
    def ks ([] "" t collect-t)
    def payload (do {kind: ["tstset"], size: [t count-t], keys: [ks]})
    payload StructUtil.jsonify
  ]
]

# Rebuild a set from an `encode` string (raises on a non-tstset payload).
def set-decode fn [
  [s:String] [Any] [
    def p (s StructUtil.parse)
    if ((p "kind" get) "tstset" eq) [ (p "keys" get) set-from-keys ] [
      def msg `TstSet.decode: expected kind 'tstset', got '${(p "kind" get)}'`
      raise msg
    ]
  ]
]


# --- namespaces -----------------------------------------------------

export "TstMap" {
  make:                map-make/r
  set:                 map-set/r
  get:                 map-get/r
  has:                 map-has/r
  delete:              map-delete/r
  keys:                map-keys/r
  values:              map-values/r
  entries:             map-entries/r
  size:                map-size/r
  height:              map-height/r
  keys-with-prefix:    map-keys-with-prefix/r
  entries-with-prefix: map-entries-with-prefix/r
  longest-prefix:      map-longest-prefix/r
  from-entries:        map-from-entries/r
  encode:              map-encode/r
  decode:              map-decode/r
}

export "TstSet" {
  make:           set-make/r
  add:            set-add/r
  has:            set-has/r
  delete:         set-delete/r
  keys:           set-keys/r
  size:           set-size/r
  height:         set-height/r
  with-prefix:    set-with-prefix/r
  longest-prefix: set-longest-prefix/r
  from-keys:      set-from-keys/r
  encode:         set-encode/r
  decode:         set-decode/r
}
