# trie: a standard prefix tree (trie) over String keys, in AQL.
#
# This file exports TWO namespaces from one module:
#
#   TrieMap — an associative map keyed by String, with prefix queries.
#   TrieSet — a set of Strings (membership), built on the same engine.
#
# A trie stores keys character by character down a tree of nodes, so every
# key sharing a prefix shares a path. That makes prefix work — "all keys
# starting with `ca`", "the longest stored key that prefixes this string" —
# cheap and natural, which is the whole reason to reach for a trie.
#
# --- representation -------------------------------------------------
#
# A node is a plain Map with three fixed fields (bindings that hold one are
# named `nd`, because `node` itself is a reserved built-in word):
#
#   { end: Boolean,   # true if a key terminates here
#     val: Any,       # the value bound to that key (TrieSet stores `true`)
#     kids: Map }     # children, keyed by single character
#
# Children are a real computed-key Map: `{[ch]: node}` literals, copy-returning
# `kids set (ch) child` updates, `kids get (ch)` lookups, and `StructUtil.items`
# enumeration (which yields KEY-SORTED [char, node] pairs — so every traversal
# below emits keys in lexicographic order by construction, and listing words
# need no trailing sort). Earlier aql could not build or walk a map with
# computed keys, which forced children into an association list; that gap was
# closed upstream, and the list workaround is retired.
#
# Tries here are PERSISTENT (immutable): every `set`/`add`/`delete` returns a
# new trie and leaves the input untouched. Nodes are rebuilt along the edited
# path with `mk-node`, and `set` on a Map is copy-returning, so subtrees are
# shared, never mutated. (We still never use StructUtil.merge to update a
# node — it is a deep, index-wise merge.)
#
# Calling convention: like the rest of AQL, the receiver comes first and the
# arguments follow — `t key val TrieMap.set`. Forward args have precedence, so
# a call resolves at the next word or paren; `end`/parens are needed only to
# separate a call from a following bare literal.
#
# Imported via `import "./trie.aql"`. The only dependency is the standard
# `aql:struct-util` module (map enumeration + jsonic parsing).

import "aql:struct-util"


# --- node construction ----------------------------------------------

# A fresh, empty node: no key ends here, no value, no children.
def empty-node fn [
  [] [Map] [ {end: false, val: none, kids: {}} ]
]

# Build a node from its three fields. The flag parameter is named `fin` (not
# `end`) because `end` is the AQL call terminator and cannot be a binding name;
# the stored *field* is still "end". Call: `kids val fin mk-node`.
def mk-node fn [
  [fin:Any val:Any kids:Any] [Map] [
    do {end: [fin], val: [val], kids: [kids]}
  ]
]


# --- child access ---------------------------------------------------

# The child node reached by single character `ch`, or `none` if absent.
# Call: `nd ch find-kid`.
def find-kid fn [
  [ch:String nd:Map] [Any] [ (nd "kids" get) get (ch) ]
]

# `nd` with the child under `ch` replaced by (or added as) `child`.
# Call: `nd ch child put-kid`.
def put-kid fn [
  [child:Map ch:String nd:Map] [Map] [
    ((nd "kids" get) set (ch) child) (nd "val" get) (nd "end" get) mk-node
  ]
]

# `nd` with the child under `ch` removed entirely. There is no key-removal
# word for maps, so rebuild the children from their entries, skipping `ch`.
# Call: `nd ch drop-kid`.
def drop-kid fn [
  [ch:String nd:Map] [Map] [
    def kept ({} ((nd "kids" get) StructUtil.items) [
      var [[pair acc]
        if ((pair get 0) ch eq) [acc] [acc set ((pair get 0)) (pair get 1)]
      ]
    ] fold)
    kept (nd "val" get) (nd "end" get) mk-node
  ]
]

# The children of `nd` as key-sorted [char, node] pairs — the one enumeration
# every traversal walks. Call: `nd kid-items`.
def kid-items fn [
  [nd:Map] [List] [ (nd "kids" get) StructUtil.items ]
]


# --- core: insert / locate ------------------------------------------

# Insert/replace `key` → `val` beneath `nd`. Call: `nd key val trie-insert`.
def trie-insert fn [
  [val:Any key:String nd:Map] [Map] [
    if ((key size) eq 0) [
      (nd "kids" get) val true mk-node
    ] [
      def ch (key slice 0 1)
      def rest (key slice 1 (key size))
      def kid (nd ch find-kid)
      def kidnode (if (kid eq none) [empty-node] [kid])
      def newkid (kidnode rest val trie-insert)
      nd ch newkid put-kid
    ]
  ]
]

# The node reached by following `key` from `nd`, or `none` if the path
# does not exist. Call: `nd key node-at`.
def node-at fn [
  [key:String nd:Map] [Any] [
    if ((key size) eq 0) [nd] [
      def ch (key slice 0 1)
      def rest (key slice 1 (key size))
      def kid (nd ch find-kid)
      if (kid eq none) [none] [kid rest node-at]
    ]
  ]
]


# --- core: delete ---------------------------------------------------

# A node carrying no value and no children is dead and gets pruned after a
# delete, so the tree never accumulates empty paths. Call: `nd dead-node`.
def dead-node fn [
  [nd:Map] [Boolean] [
    ((nd "end" get) not) and (((nd "kids" get) size) eq 0)
  ]
]

# Remove `key` beneath `nd`, pruning now-empty branches on the way back up.
# Deleting an absent key is a no-op. Call: `nd key trie-delete`.
def trie-delete fn [
  [key:String nd:Map] [Map] [
    if ((key size) eq 0) [
      (nd "kids" get) none false mk-node
    ] [
      def ch (key slice 0 1)
      def rest (key slice 1 (key size))
      def kid (nd ch find-kid)
      if (kid eq none) [nd] [
        def newkid (kid rest trie-delete)
        if (newkid dead-node) [nd ch drop-kid] [nd ch newkid put-kid]
      ]
    ]
  ]
]


# --- traversal ------------------------------------------------------
#
# Children enumerate in character order (`kid-items`), and a node's own key
# is emitted before its children's, so every collector below produces keys
# already in lexicographic order.

# Append every terminating key at or below `nd` (prefixed by `pfx`) to
# `acc`, in sorted order. Call: `acc pfx nd collect-keys`.
def collect-keys fn [
  [nd:Map pfx:String acc:List] [List] [
    def acc2 (if (nd "end" get) [acc pfx push] [acc])
    acc2 (nd kid-items) [
      var [[pair a]
        def newpfx `${pfx}${(pair get 0)}`
        a newpfx (pair get 1) collect-keys
      ]
    ] fold
  ]
]

# As `collect-keys`, but appends [key, value] pairs. Call: `acc pfx nd …`.
def collect-entries fn [
  [nd:Map pfx:String acc:List] [List] [
    def acc2 (if (nd "end" get) [acc [pfx (nd "val" get)] push] [acc])
    acc2 (nd kid-items) [
      var [[pair a]
        def newpfx `${pfx}${(pair get 0)}`
        a newpfx (pair get 1) collect-entries
      ]
    ] fold
  ]
]

# Longest stored key that is a prefix of `key`. `pfx` is the path consumed so
# far; `best` is the best terminating prefix seen (or `none`).
# Call: `nd key pfx best longest`.
def longest fn [
  [best:Any pfx:String key:String nd:Map] [Any] [
    def best2 (if (nd "end" get) [pfx] [best])
    if ((key size) eq 0) [best2] [
      def ch (key slice 0 1)
      def rest (key slice 1 (key size))
      def kid (nd ch find-kid)
      if (kid eq none) [best2] [
        kid rest `${pfx}${ch}` best2 longest
      ]
    ]
  ]
]

# Number of keys (terminating nodes) at or below `nd`. Call: `nd count-keys`.
def count-keys fn [
  [nd:Map] [Integer] [
    def here (if (nd "end" get) [1] [0])
    here (nd kid-items) [
      var [[pair acc] acc ((pair get 1) count-keys) add ]
    ] fold
  ]
]

# Length of the longest root-to-leaf path (0 for an empty trie).
# Call: `nd node-height`.
def node-height fn [
  [nd:Map] [Integer] [
    0 (nd kid-items) [
      var [[pair acc]
        def h ((pair get 1) node-height 1 add)
        if (h gt acc) [h] [acc]
      ]
    ] fold
  ]
]


# --- construction from data -----------------------------------------

# Build a trie from a list of keys (the inverse of `keys`). Call: `keys build-from-keys`.
def build-from-keys fn [
  [ks:List] [Map] [
    empty-node ks [ var [[k acc] (acc k true trie-insert) ] ] fold
  ]
]

# Build a trie from a list of [key, value] pairs (the inverse of `entries`).
# Call: `entries build-from-entries`.
def build-from-entries fn [
  [entries:List] [Map] [
    empty-node entries [ var [[e acc] (acc (e get 0) (e get 1) trie-insert) ] ] fold
  ]
]


# --- serialisation --------------------------------------------------
#
# `encode` interpolates a payload map to its jsonic text; `decode` parses
# that text back (`StructUtil.parse`) and rebuilds the trie from the data.
# A payload of the wrong kind raises a catchable error.

def encode-map fn [
  [nd:Map] [String] [
    def es ([] "" nd collect-entries)
    def payload (do {kind: ["triemap"], size: [nd count-keys], entries: [es]})
    payload StructUtil.jsonify
  ]
]

def encode-set fn [
  [nd:Map] [String] [
    def ks ([] "" nd collect-keys)
    def payload (do {kind: ["trieset"], size: [nd count-keys], keys: [ks]})
    payload StructUtil.jsonify
  ]
]

def decode-map fn [
  [s:String] [Map] [
    def p (s StructUtil.parse)
    if ((p "kind" get) "triemap" eq) [ (p "entries" get) build-from-entries ] [
      def msg `TrieMap.decode: expected kind 'triemap', got '${(p "kind" get)}'`
      raise msg
    ]
  ]
]

def decode-set fn [
  [s:String] [Map] [
    def p (s StructUtil.parse)
    if ((p "kind" get) "trieset" eq) [ (p "keys" get) build-from-keys ] [
      def msg `TrieSet.decode: expected kind 'trieset', got '${(p "kind" get)}'`
      raise msg
    ]
  ]
]


# --- advanced queries: fuzzy (edit distance) ------------------------
#
# Walk the trie carrying one row of the Levenshtein dynamic-programming
# matrix between the path-so-far and the query, pruning a subtree as soon
# as the whole row exceeds the distance budget `k` (Hanov's algorithm).

def min3 fn [
  [a:Integer b:Integer c:Integer] [Integer] [
    def m (if (a lt b) [a] [b]) if (m lt c) [m] [c]
  ]
]

def list-min fn [
  [xs:List] [Integer] [
    (xs get 0) xs [ var [[x acc] if (x lt acc) [x] [acc] ] ] fold
  ]
]

# The next DP row for `letter` against `query`, given the parent row `prow`.
# Call: `letter query prow build-row`.
def build-row fn [
  [prow:List query:String letter:String] [List] [
    def cols ((query size) 1 add)
    def row0 [ ((prow get 0) 1 add) ]
    row0 (range 1 cols) [
      var [[i row]
        def insc ((row  get ((i 1 sub))) 1 add)
        def delc ((prow get (i))         1 add)
        def qc   (query slice (i 1 sub) i)
        def repc ((prow get ((i 1 sub))) (if (qc letter eq) [0] [1]) add)
        row (insc delc repc min3) push
      ]
    ] fold
  ]
]

# Collect keys within distance `k`, descending children and updating rows.
# A key is emitted before its subtree is descended and children come in
# character order, so the result is sorted. Call: `acc prefix prow k query nd fuzzy-go`.
def fuzzy-go fn [
  [nd:Map query:String k:Integer prow:List prefix:String acc:List] [List] [
    acc (nd kid-items) [
      var [[pair a]
        def c     (pair get 0)
        def child (pair get 1)
        def row   (c query prow build-row)
        def np    (prefix c add)
        def last  (row get ((query size)))
        def a1 (if ((child "end" get) and (last lte k)) [a np push] [a])
        if ((row list-min) lte k) [ (a1 np row k query child fuzzy-go) ] [a1]
      ]
    ] fold
  ]
]

# Every key within Levenshtein distance `k` of `query`, sorted.
# Call: `nd query k trie-within`.
def trie-within fn [
  [k:Integer query:String nd:Map] [List] [
    def row0 (iota ((query size) 1 add))
    def seed (if ((nd "end" get) and ((query size) lte k)) [ [] "" push ] [[]])
    seed "" row0 k query nd fuzzy-go
  ]
]


# --- advanced queries: wildcard match -------------------------------
#
# Match keys against a pattern where `?` is any single character, `*` is
# any run of characters (including none), and every other character is a
# literal. The `*` arm emits this node's matches before each child's, so
# emission order is NOT lexicographic and trie-match sorts at the end.

def match-go fn [
  [nd:Map pattern:String prefix:String acc:List] [List] [
    if ((pattern size) eq 0) [
      if (nd "end" get) [acc prefix push] [acc]
    ] [
      def p0    (pattern slice 0 1)
      def prest (pattern slice 1 (pattern size))
      if (p0 "?" eq) [
        acc (nd kid-items) [
          var [[pair a]
            def np (prefix (pair get 0) add)
            (a np prest (pair get 1) match-go)
          ]
        ] fold
      ] [
        if (p0 "*" eq) [
          def acc0 (acc prefix prest nd match-go)
          acc0 (nd kid-items) [
            var [[pair a]
              def np (prefix (pair get 0) add)
              (a np pattern (pair get 1) match-go)
            ]
          ] fold
        ] [
          def child (nd p0 find-kid)
          if (child eq none) [acc] [
            def np (prefix p0 add)
            (acc np prest child match-go)
          ]
        ]
      ]
    ]
  ]
]

# Every key matching the wildcard `pattern`, sorted. Call: `nd pattern trie-match`.
def trie-match fn [
  [pattern:String nd:Map] [List] [ ([] "" pattern nd match-go) sort ]
]



# --- TrieMap surface ------------------------------------------------
#
# Signatures are written in reverse of the call order (the AQL rule that the
# first parameter is the top of the stack), so each call reads receiver-first:
# `t key val TrieMap.set end`.

def map-make fn [ [] [Map] [empty-node] ]

def map-set fn [
  [val:Any key:String t:Map] [Map] [ t key val trie-insert ]
]

def map-get fn [
  [key:String t:Map] [Any] [
    def n (t key node-at)
    if (n eq none) [none] [ if (n "end" get) [n "val" get] [none] ]
  ]
]

def map-has fn [
  [key:String t:Map] [Boolean] [
    def n (t key node-at)
    if (n eq none) [false] [n "end" get]
  ]
]

def map-delete fn [
  [key:String t:Map] [Map] [ t key trie-delete ]
]

def map-keys fn [ [t:Map] [List] [ [] "" t collect-keys ] ]

def map-entries fn [ [t:Map] [List] [ [] "" t collect-entries ] ]

# Values in key order. `entries` is already sorted [key, value] pairs, so we
# pluck the value column with the receiverless lens `$.1` (a Reach value that
# `each` applies to every element) — no second walk, no per-key lookup.
def map-values fn [
  [t:Map] [List] [ (t map-entries) each $.1 ]
]

def map-size fn [ [t:Map] [Integer] [ t count-keys ] ]

def map-height fn [ [t:Map] [Integer] [ t node-height ] ]

# Keys at or below `prefix`, sorted. A prefix that is not present yields [].
def map-keys-with-prefix fn [
  [prefix:String t:Map] [List] [
    def n (t prefix node-at)
    if (n eq none) [[]] [ [] prefix n collect-keys ]
  ]
]

def map-entries-with-prefix fn [
  [prefix:String t:Map] [List] [
    def n (t prefix node-at)
    if (n eq none) [[]] [ [] prefix n collect-entries ]
  ]
]

def map-longest-prefix fn [
  [key:String t:Map] [Any] [ t key "" none longest ]
]

# Keys within Levenshtein distance `k` of `query`, sorted.
def map-within fn [ [k:Integer query:String t:Map] [List] [ t query k trie-within ] ]

# Keys matching a `?`/`*` wildcard pattern, sorted.
def map-match fn [ [pattern:String t:Map] [List] [ t pattern trie-match ] ]

# Rebuild a map from a list of [key, value] pairs (inverse of `entries`).
def map-from-entries fn [ [entries:List] [Map] [ entries build-from-entries ] ]

def map-encode fn [ [t:Map] [String] [ t encode-map ] ]

# Rebuild a map from an `encode` string (raises on a non-triemap payload).
def map-decode fn [ [s:String] [Map] [ s decode-map ] ]


# --- TrieSet surface ------------------------------------------------
#
# A set is a map whose values are all `true`; membership is the `end` flag.

def set-make fn [ [] [Map] [empty-node] ]

def set-add fn [
  [key:String t:Map] [Map] [ t key true trie-insert ]
]

def set-has fn [
  [key:String t:Map] [Boolean] [
    def n (t key node-at)
    if (n eq none) [false] [n "end" get]
  ]
]

def set-delete fn [
  [key:String t:Map] [Map] [ t key trie-delete ]
]

def set-keys fn [ [t:Map] [List] [ [] "" t collect-keys ] ]

def set-size fn [ [t:Map] [Integer] [ t count-keys ] ]

def set-height fn [ [t:Map] [Integer] [ t node-height ] ]

def set-with-prefix fn [
  [prefix:String t:Map] [List] [
    def n (t prefix node-at)
    if (n eq none) [[]] [ [] prefix n collect-keys ]
  ]
]

def set-longest-prefix fn [
  [key:String t:Map] [Any] [ t key "" none longest ]
]

# Keys within Levenshtein distance `k` of `query`, sorted.
def set-within fn [ [k:Integer query:String t:Map] [List] [ t query k trie-within ] ]

# Keys matching a `?`/`*` wildcard pattern, sorted.
def set-match fn [ [pattern:String t:Map] [List] [ t pattern trie-match ] ]

# Rebuild a set from a list of keys (inverse of `keys`).
def set-from-keys fn [ [ks:List] [Map] [ ks build-from-keys ] ]

def set-encode fn [ [t:Map] [String] [ t encode-set ] ]

# Rebuild a set from an `encode` string (raises on a non-trieset payload).
def set-decode fn [ [s:String] [Map] [ s decode-set ] ]


# --- namespaces -----------------------------------------------------

export "TrieMap" {
  make:                map-make/r
  set:                 map-set/r
  get:                 map-get/r
  has:                 map-has/r
  delete:              map-delete/r
  keys:                map-keys/r
  values:              map-values/r
  entries:             map-entries/r
  size:                map-size/r
  height:              map-height/r
  keys-with-prefix:    map-keys-with-prefix/r
  entries-with-prefix: map-entries-with-prefix/r
  longest-prefix:      map-longest-prefix/r
  within:              map-within/r
  match:               map-match/r
  from-entries:        map-from-entries/r
  encode:              map-encode/r
  decode:              map-decode/r
}

export "TrieSet" {
  make:           set-make/r
  add:            set-add/r
  has:            set-has/r
  delete:         set-delete/r
  keys:           set-keys/r
  size:           set-size/r
  height:         set-height/r
  with-prefix:    set-with-prefix/r
  longest-prefix: set-longest-prefix/r
  within:         set-within/r
  match:          set-match/r
  from-keys:      set-from-keys/r
  encode:         set-encode/r
  decode:         set-decode/r
}
